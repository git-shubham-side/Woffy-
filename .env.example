# ==============================================================================
# Woffy - Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# Database (MongoDB Atlas for Production, Local for Development)
# Production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/woffy?retryWrites=true&w=majority
# Development: mongodb://127.0.0.1:27017/Woffy
DBURL=mongodb://127.0.0.1:27017/Woffy

# Session Security (Strong random string in production)
SESSION_SECRET=your_super_secret_session_key_12345

# Cloudinary Storage (Persistent Image Uploads in Production)
# Get these free from https://cloudinary.com (Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification Service (Nodemailer)
ADMIN_EMAIL=rathodshubham7711@gmail.com
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Custom SMTP (Optional, used if EMAIL_SERVICE is not gmail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password