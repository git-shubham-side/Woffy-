<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 Not Found | Woofy</title>

    <!-- Design System Typography: Inter -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Link to your main stylesheet -->
    <link rel="stylesheet" href="/Route-Not-Found/route-not-found.css" />
  </head>
  <body>
    <!-- 1. Standard Layout: Dashboard Navigation -->
    <header class="dashboard-nav">
      <div class="nav-container">
        <a href="/api/dashboard" class="logo">Woofy.</a>
      </div>
    </header>

    <!-- 2. Standard Layout: Main Container -->
    <main class="dashboard-main container">
      <!-- Back Link -->
      <a href="/api/dashboard" class="back-link">
        <i data-lucide="arrow-left"></i> Back to Home
      </a>

      <!-- 3. Standard Layout: Page Header -->
      <div class="page-header">
        <h1>404 - Page Not Found</h1>
        <p>Oops! Looks like you've barked up the wrong tree.</p>
      </div>

      <!-- 4. Content Card (Using form-card as a structural wrapper for the message) -->
      <div class="form-card">
        <h2><i data-lucide="search-x"></i> Are you lost?</h2>
        <p>
          We sniffed around everywhere but couldn't find the page you're looking
          for. The link might be broken, or the page may have been removed.
        </p>

        <br />

        <a href="/api/dashboard" class="btn btn-primary">
          <i data-lucide="home"></i> Return to Dashboard
        </a>
        <!-- <a href="/support" class="btn btn-secondary">
          <i data-lucide="life-buoy"></i> Get Help
        </a> -->
      </div>
    </main>

    <!-- 5. Standard Layout: Footer -->
    <footer class="dash-footer">
      <p>Woofy | PetCare Application.</p>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
      lucide.createIcons();
    </script>
    <!-- Default Statcounter code for Woffy https://woffy.up.railway.app/ -->
    <script type="text/javascript">
    var sc_project=13353492; 
    var sc_invisible=1; 
    var sc_security="b129a7bd"; 
    </script>
    <script type="text/javascript"
    src="https://www.statcounter.com/counter/counter.js" async></script>
    <noscript><div class="statcounter"><a title="Web Analytics"
    href="https://statcounter.com/" target="_blank"><img class="statcounter"
    src="https://c.statcounter.com/13353492/0/b129a7bd/1/" alt="Web Analytics"
    referrerPolicy="no-referrer-when-downgrade"></a></div></noscript>
    <!-- End of Statcounter Code -->
  </body>
</html>
