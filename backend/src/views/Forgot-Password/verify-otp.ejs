<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP & Set New Password | Woofy</title>
    <meta name="description" content="Verify your 6-digit OTP code sent via email and securely set your new password for Woofy." />

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/Forgot-Password/forgot-password.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Subtle Background Ambient Light -->
    <div class="bg-mesh" aria-hidden="true">
      <div class="mesh-blob blob-1"></div>
      <div class="mesh-blob blob-2"></div>
      <div class="mesh-grid-pattern"></div>
    </div>

    <div class="auth-split-layout">
      <!-- Left Side: Brand Showcase Panel -->
      <aside class="auth-showcase-panel" aria-label="Woofy Security Verification">
        <div class="showcase-inner">
          <div class="showcase-top">
            <a href="/" class="brand-logo" aria-label="Woofy Home">
              <span class="logo-icon-box">
                <i data-lucide="paw-print"></i>
              </span>
              <span class="brand-name">Woofy<span class="dot">.</span></span>
            </a>

            <a href="/api/forget-pass" class="btn-back-home">
              <i data-lucide="arrow-left"></i>
              <span>Resend Email</span>
            </a>
          </div>

          <div class="showcase-content">
            <div class="announcement-pill">
              <span class="live-pulse"></span>
              <span class="pill-text">Two-Way Authentication</span>
            </div>

            <h1 class="showcase-title">
              Verify Your Code &
              <span class="gradient-text">Set New Password.</span>
            </h1>

            <p class="showcase-desc">
              We've dispatched a 6-digit security OTP to your inbox. Enter it below along with your new password to restore instant access.
            </p>

            <div class="feature-card-list">
              <div class="feature-item">
                <div class="feature-icon icon-blue">
                  <i data-lucide="mail-check"></i>
                </div>
                <div class="feature-text">
                  <strong>Check Your Inbox</strong>
                  <span>Look for an email from Woofy Security with your 6-digit OTP</span>
                </div>
              </div>

              <div class="feature-item">
                <div class="feature-icon icon-amber">
                  <i data-lucide="clock"></i>
                </div>
                <div class="feature-text">
                  <strong>15-Minute Expiry</strong>
                  <span>Your OTP code is valid for 15 minutes from generation</span>
                </div>
              </div>

              <div class="feature-item">
                <div class="feature-icon icon-emerald">
                  <i data-lucide="shield-check"></i>
                </div>
                <div class="feature-text">
                  <strong>Strong Protection</strong>
                  <span>Bcrypt salted hashing protects your updated credentials</span>
                </div>
              </div>
            </div>
          </div>

          <div class="showcase-footer-card">
            <div class="card-stars">
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
            </div>
            <p class="card-quote">
              "Direct OTP verification saved me so much time when I needed to update my account password on my phone."
            </p>
            <div class="card-author">
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80"
                alt="Priya S"
              />
              <div>
                <strong>Priya Sharma</strong>
                <span>Pet Parent • Mumbai</span>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Right Side: OTP Verification Form -->
      <main class="auth-form-surface">
        <div class="form-wrapper">
          <div class="mobile-brand-bar">
            <a href="/" class="brand-logo">
              <span class="logo-icon-box">
                <i data-lucide="paw-print"></i>
              </span>
              <span class="brand-name">Woofy<span class="dot">.</span></span>
            </a>
            <a href="/api/forget-pass" class="btn-back-home mobile-back">
              <i data-lucide="arrow-left"></i>
              <span>Back</span>
            </a>
          </div>

          <div class="form-header-box">
            <span class="section-badge">Step 2: Verification</span>
            <h2 class="form-title">Enter 6-digit OTP</h2>
            <p class="form-subtitle">Provide the code sent to your email and choose your new password.</p>
          </div>

          <%- include('../partials/flash-messages') %>

          <form action="/api/verify-reset-otp" method="POST" novalidate>
            <!-- Email -->
            <div class="form-group-item">
              <label for="email">Registered Email <span class="req">*</span></label>
              <div class="input-field-wrap">
                <i data-lucide="mail" class="field-icon"></i>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input-control"
                  value="<%= typeof email !== 'undefined' ? email : '' %>"
                  placeholder="name@example.com"
                  required
                />
              </div>
            </div>

            <!-- 6-Digit OTP -->
            <div class="form-group-item">
              <label for="otp">6-Digit Verification Code <span class="req">*</span></label>
              <div class="input-field-wrap">
                <input
                  type="text"
                  id="otp"
                  name="otp"
                  class="form-input-control otp-input-control"
                  placeholder="------"
                  maxlength="6"
                  required
                  autofocus
                  autocomplete="one-time-code"
                />
              </div>
            </div>

            <!-- New Password -->
            <div class="form-group-item">
              <label for="password">New Password (Min. 8 chars) <span class="req">*</span></label>
              <div class="input-field-wrap">
                <i data-lucide="lock" class="field-icon"></i>
                <input
                  type="password"
                  id="password"
                  name="password"
                  class="form-input-control"
                  placeholder="At least 8 characters"
                  minlength="8"
                  required
                  autocomplete="new-password"
                />
              </div>
            </div>

            <!-- Confirm New Password -->
            <div class="form-group-item">
              <label for="confirmPassword">Confirm New Password <span class="req">*</span></label>
              <div class="input-field-wrap">
                <i data-lucide="shield-check" class="field-icon"></i>
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  class="form-input-control"
                  placeholder="Re-enter new password"
                  minlength="8"
                  required
                  autocomplete="new-password"
                />
              </div>
            </div>

            <button type="submit" class="btn-auth-action">
              <span>Verify & Set New Password</span>
              <i data-lucide="check"></i>
            </button>
          </form>

          <div class="form-footer-box">
            <p>
              Didn't receive the email?
              <a href="/api/forget-pass">Resend reset email</a>
            </p>
          </div>

          <div class="security-badge-note">
            <i data-lucide="shield-check"></i>
            <span>End-to-end 256-bit encrypted authentication</span>
          </div>
        </div>
      </main>
    </div>

    <script>
      lucide.createIcons();
    </script>
    <!-- Default Statcounter code for Woffy https://woffy.up.railway.app/ -->
    <script type="text/javascript">
    var sc_project=13353492; 
    var sc_invisible=1; 
    var sc_security="b129a7bd"; 
    </script>
    <script type="text/javascript"
    src="https://www.statcounter.com/counter/counter.js" async></script>
    <noscript><div class="statcounter"><a title="Web Analytics"
    href="https://statcounter.com/" target="_blank"><img class="statcounter"
    src="https://c.statcounter.com/13353492/0/b129a7bd/1/" alt="Web Analytics"
    referrerPolicy="no-referrer-when-downgrade"></a></div></noscript>
    <!-- End of Statcounter Code -->
  </body>
</html>
