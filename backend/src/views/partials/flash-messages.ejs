<% if ((typeof success_msg !== 'undefined' && success_msg.length > 0) || (typeof error_msg !== 'undefined' && error_msg.length > 0)) { %>
  <div class="flash-messages-container" style="margin-bottom: 1.5rem; width: 100%;">
    <style>
      .flash-messages-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .flash-alert {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1.1rem;
        border-radius: 6px;
        font-size: 0.925rem;
        font-family: inherit;
        line-height: 1.4;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .flash-alert-content {
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }
      .flash-alert-icon {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .flash-alert-success {
        background-color: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
      }
      .flash-alert-success .flash-alert-icon {
        color: #16a34a;
      }
      .flash-alert-error {
        background-color: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }
      .flash-alert-error .flash-alert-icon {
        color: #dc2626;
      }
      .flash-close-btn {
        background: transparent;
        border: none;
        cursor: pointer;
        font-size: 1.25rem;
        line-height: 1;
        padding: 0 0 0 0.75rem;
        color: inherit;
        opacity: 0.65;
        transition: opacity 0.2s;
        display: flex;
        align-items: center;
      }
      .flash-close-btn:hover {
        opacity: 1;
      }
    </style>

    <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
      <% success_msg.forEach(function(msg) { %>
        <div class="flash-alert flash-alert-success" role="alert">
          <div class="flash-alert-content">
            <span class="flash-alert-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </span>
            <span><%= msg %></span>
          </div>
          <button type="button" class="flash-close-btn" aria-label="Close" onclick="this.closest('.flash-alert').remove();">&times;</button>
        </div>
      <% }); %>
    <% } %>

    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
      <% error_msg.forEach(function(msg) { %>
        <div class="flash-alert flash-alert-error" role="alert">
          <div class="flash-alert-content">
            <span class="flash-alert-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </span>
            <span><%= msg %></span>
          </div>
          <button type="button" class="flash-close-btn" aria-label="Close" onclick="this.closest('.flash-alert').remove();">&times;</button>
        </div>
      <% }); %>
    <% } %>
  </div>
<% } %>
