<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password — Woofy</title>
    <meta name="description" content="Set a new secure password for your Woofy pet care account." />

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/Forgot-Password/forgot-password.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Subtle Background Ambient Light -->
    <div class="bg-mesh" aria-hidden="true">
      <div class="mesh-blob blob-1"></div>
      <div class="mesh-blob blob-2"></div>
      <div class="mesh-grid-pattern"></div>
    </div>

    <div class="auth-split-layout">
      <!-- Left Side: Brand Showcase Panel -->
      <aside class="auth-showcase-panel" aria-label="Woofy Security">
        <div class="showcase-inner">
          <div class="showcase-top">
            <a href="/" class="brand-logo" aria-label="Woofy Home">
              <span class="logo-icon-box">
                <i data-lucide="paw-print"></i>
              </span>
              <span class="brand-name">Woofy<span class="dot">.</span></span>
            </a>

            <a href="/api/login" class="btn-back-home">
              <i data-lucide="arrow-left"></i>
              <span>Back to Login</span>
            </a>
          </div>

          <div class="showcase-content">
            <div class="announcement-pill">
              <span class="live-pulse"></span>
              <span class="pill-text">Verified Link Access</span>
            </div>

            <h1 class="showcase-title">
              Create Your New
              <span class="gradient-text">Master Password.</span>
            </h1>

            <p class="showcase-desc">
              Your security link has been verified. Choose a strong, unique password to safeguard your pet's medical documents and health vault.
            </p>

            <div class="feature-card-list">
              <div class="feature-item">
                <div class="feature-icon icon-blue">
                  <i data-lucide="shield-check"></i>
                </div>
                <div class="feature-text">
                  <strong>Minimum 8 Characters</strong>
                  <span>Mix upper and lowercase letters, numbers, and symbols</span>
                </div>
              </div>

              <div class="feature-item">
                <div class="feature-icon icon-amber">
                  <i data-lucide="lock"></i>
                </div>
                <div class="feature-text">
                  <strong>Automated Salt Hashing</strong>
                  <span>Your password is encrypted with bcrypt before being stored</span>
                </div>
              </div>

              <div class="feature-item">
                <div class="feature-icon icon-emerald">
                  <i data-lucide="check-circle-2"></i>
                </div>
                <div class="feature-text">
                  <strong>Instant Login Access</strong>
                  <span>You'll be directed to your dashboard right after updating</span>
                </div>
              </div>
            </div>
          </div>

          <div class="showcase-footer-card">
            <div class="card-stars">
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
            </div>
            <p class="card-quote">
              "Woofy keeps all our pet vaccinations organized and our account security is rock solid."
            </p>
            <div class="card-author">
              <img
                src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=100&q=80"
                alt="Pet Parent"
              />
              <div>
                <strong>Ananya Joshi</strong>
                <span>Pet Parent • Pune</span>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Right Side: Reset Password Form -->
      <main class="auth-form-surface">
        <div class="form-wrapper">
          <div class="mobile-brand-bar">
            <a href="/" class="brand-logo">
              <span class="logo-icon-box">
                <i data-lucide="paw-print"></i>
              </span>
              <span class="brand-name">Woofy<span class="dot">.</span></span>
            </a>
            <a href="/api/login" class="btn-back-home mobile-back">
              <i data-lucide="arrow-left"></i>
              <span>Login</span>
            </a>
          </div>

          <div class="form-header-box">
            <span class="section-badge">Update Password</span>
            <h2 class="form-title">Set new password</h2>
            <p class="form-subtitle">Choose a new password for account <%= typeof email !== 'undefined' ? `(${email})` : '' %>.</p>
          </div>

          <%- include('../partials/flash-messages') %>

          <form action="/api/reset-password/<%= token %>" method="POST" novalidate>
            <!-- New Password -->
            <div class="form-group-item">
              <label for="password">New Password <span class="req">*</span></label>
              <div class="input-field-wrap">
                <i data-lucide="lock" class="field-icon"></i>
                <input
                  type="password"
                  id="password"
                  name="password"
                  class="form-input-control"
                  placeholder="Min. 8 characters"
                  minlength="8"
                  required
                  autofocus
                  autocomplete="new-password"
                />
              </div>
            </div>

            <!-- Confirm New Password -->
            <div class="form-group-item">
              <label for="confirmPassword">Confirm New Password <span class="req">*</span></label>
              <div class="input-field-wrap">
                <i data-lucide="shield-check" class="field-icon"></i>
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  class="form-input-control"
                  placeholder="Re-enter new password"
                  minlength="8"
                  required
                  autocomplete="new-password"
                />
              </div>
            </div>

            <button type="submit" class="btn-auth-action">
              <span>Update Password & Continue</span>
              <i data-lucide="arrow-right"></i>
            </button>
          </form>

          <div class="form-footer-box">
            <p>
              Remember your login?
              <a href="/api/login">Return to sign in</a>
            </p>
          </div>

          <div class="security-badge-note">
            <i data-lucide="shield-check"></i>
            <span>End-to-end 256-bit encrypted authentication</span>
          </div>
        </div>
      </main>
    </div>

    <script>
      lucide.createIcons();
    </script>
  </body>
</html>
