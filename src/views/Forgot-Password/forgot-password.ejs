<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password | Woofy Pet Health Platform</title>
    <meta name="description" content="Reset your Woofy account password securely using a 1-click verification link or 6-digit OTP code." />

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/Forgot-Password/forgot-password.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Subtle Background Ambient Light -->
    <div class="bg-mesh" aria-hidden="true">
      <div class="mesh-blob blob-1"></div>
      <div class="mesh-blob blob-2"></div>
      <div class="mesh-grid-pattern"></div>
    </div>

    <div class="auth-split-layout">
      <!-- Left Side: Brand Showcase Panel (Desktop / Tablet) -->
      <aside class="auth-showcase-panel" aria-label="Woofy Account Security">
        <div class="showcase-inner">
          <!-- Top Bar -->
          <div class="showcase-top">
            <a href="/" class="brand-logo" aria-label="Woofy Home">
              <span class="logo-icon-box">
                <i data-lucide="paw-print"></i>
              </span>
              <span class="brand-name">Woofy<span class="dot">.</span></span>
            </a>

            <a href="/" class="btn-back-home">
              <i data-lucide="arrow-left"></i>
              <span>Back to Home</span>
            </a>
          </div>

          <!-- Showcase Center Content -->
          <div class="showcase-content">
            <div class="announcement-pill">
              <span class="live-pulse"></span>
              <span class="pill-text">Safe & Encrypted Recovery</span>
            </div>

            <h1 class="showcase-title">
              Instant Account Access.
              <span class="gradient-text">Zero Hassle.</span>
            </h1>

            <p class="showcase-desc">
              Forgot your credentials? We'll dispatch a secure 1-click verification link and a 6-digit OTP straight to your registered email in seconds.
            </p>

            <!-- Feature Highlight List -->
            <div class="feature-card-list">
              <div class="feature-item">
                <div class="feature-icon icon-blue">
                  <i data-lucide="shield-check"></i>
                </div>
                <div class="feature-text">
                  <strong>1-Click Instant Reset Link</strong>
                  <span>Fast, SHA-256 encrypted password reset link valid for 15 minutes</span>
                </div>
              </div>

              <div class="feature-item">
                <div class="feature-icon icon-amber">
                  <i data-lucide="key-round"></i>
                </div>
                <div class="feature-text">
                  <strong>6-Digit Direct Verification OTP</strong>
                  <span>Quick OTP option if you prefer resetting directly on your device</span>
                </div>
              </div>

              <div class="feature-item">
                <div class="feature-icon icon-emerald">
                  <i data-lucide="lock"></i>
                </div>
                <div class="feature-text">
                  <strong>Protected Pet Records</strong>
                  <span>Your medical histories, vaccines, and doctor records remain 100% safe</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Mini Showcase Review Card -->
          <div class="showcase-footer-card">
            <div class="card-stars">
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
              <i data-lucide="star"></i>
            </div>
            <p class="card-quote">
              "Resetting our pet parent credentials took literally 10 seconds with the direct OTP code. Super smooth and secure."
            </p>
            <div class="card-author">
              <img
                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80"
                alt="Rahul Verma"
              />
              <div>
                <strong>Rahul Verma</strong>
                <span>Beagle Parent • Bangalore</span>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Right Side: Forgot Password Form -->
      <main class="auth-form-surface">
        <div class="form-wrapper">
          <!-- Mobile Brand Bar -->
          <div class="mobile-brand-bar">
            <a href="/" class="brand-logo">
              <span class="logo-icon-box">
                <i data-lucide="paw-print"></i>
              </span>
              <span class="brand-name">Woofy<span class="dot">.</span></span>
            </a>
            <a href="/api/login" class="btn-back-home mobile-back">
              <i data-lucide="arrow-left"></i>
              <span>Login</span>
            </a>
          </div>

          <!-- Form Header -->
          <div class="form-header-box">
            <span class="section-badge">Password Recovery</span>
            <h2 class="form-title">Forgot your password?</h2>
            <p class="form-subtitle">Enter your registered email address to receive recovery instructions.</p>
          </div>

          <!-- Flash Notification Messages -->
          <%- include('../partials/flash-messages') %>

          <!-- Form -->
          <form action="/api/forget-pass" method="POST" novalidate>
            <div class="form-group-item">
              <label for="email">Email Address <span class="req">*</span></label>
              <div class="input-field-wrap">
                <i data-lucide="mail" class="field-icon"></i>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input-control"
                  placeholder="name@example.com"
                  required
                  autofocus
                  autocomplete="email"
                />
              </div>
            </div>

            <button type="submit" id="submitBtn" class="btn-auth-action">
              <span>Send Recovery Link & OTP</span>
              <i data-lucide="arrow-right"></i>
            </button>
          </form>

          <!-- Form Footer Links -->
          <div class="form-footer-box">
            <p>
              Remembered your password?
              <a href="/api/login">Sign in here</a>
            </p>
          </div>

          <!-- Security Badge Note -->
          <div class="security-badge-note">
            <i data-lucide="shield-check"></i>
            <span>End-to-end 256-bit encrypted recovery system</span>
          </div>
        </div>
      </main>
    </div>

    <script>
      lucide.createIcons();

      const form = document.querySelector('form');
      const submitBtn = document.getElementById('submitBtn');

      if (form && submitBtn) {
        form.addEventListener('submit', function() {
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.75';
          submitBtn.innerHTML = '<i data-lucide="loader" style="width:18px;height:18px;animation:spin 1s linear infinite;"></i><span>Processing...</span>';
          if (window.lucide) lucide.createIcons();
        });
      }
    </script>
    <style>
      @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>
  </body>
</html>
