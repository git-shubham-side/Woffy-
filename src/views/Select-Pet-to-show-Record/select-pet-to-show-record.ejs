<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Woofy | Premium Pet Management</title>
    <link rel="stylesheet" href="/My-Pets/my-pets.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include('../partials/navbar', { activePage: 'pets' }) %>

    <section class="pets-page">
      <div class="container">
        <!-- Flash Messages -->
        <%- include('../partials/flash-messages') %>

        <div class="pets-header reveal">
          <div>
            <h2>Select Pet to Show Records</h2>
            <p>Select which pet's complete history, health, and care records you want to view.</p>
          </div>
        </div>

        <% if (typeof pets !== 'undefined' && pets.length > 0) { %>
          <div class="pets-grid">
            <% pets.forEach(function(pet) { %>
              <div class="pet-card reveal">
                <div class="pet-card-top">
                  <% if (pet.photo) { %>
                    <img src="<%= pet.photo %>" alt="<%= pet.petName %>" class="pet-avatar-img" />
                  <% } else if (pet.photoUrl) { %>
                    <img src="<%= pet.photoUrl %>" alt="<%= pet.petName %>" class="pet-avatar-img" />
                  <% } else { %>
                    <div class="profile-avatar-fallback">
                      <%= pet.petName ? pet.petName.charAt(0).toUpperCase() : 'P' %>
                    </div>
                  <% } %>
                  <div>
                    <h3><%= pet.petName %></h3>
                    <p class="pet-sub"><%= pet.breed || pet.species %> • <%= pet.gender %></p>
                  </div>
                </div>
                <div class="pet-card-stats">
                  <div class="stat">
                    <span class="stat-label">Age</span>
                    <span class="stat-value"><%= pet.age %> yrs</span>
                  </div>
                  <div class="stat">
                    <span class="stat-label">Weight</span>
                    <span class="stat-value"><%= pet.weight %> kg</span>
                  </div>
                  <div class="stat">
                    <span class="stat-label">Vaccinated</span>
                    <span class="stat-value"><%= pet.vaccinated %></span>
                  </div>
                </div>
                <a
                  href="/api/show-records/<%= pet._id %>"
                  class="btn btn-primary pet-card-btn"
                  ><i data-lucide="clipboard-list"></i> View <%= pet.petName %>'s Records</a
                >
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div style="text-align: center; padding: 4rem 2rem; background: var(--white); border: 1px solid var(--border-color); border-radius: var(--border-radius); margin-top: 1.5rem;">
            <h3 style="margin-bottom: 0.5rem; color: var(--primary-color);">No pets found</h3>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">You need to create a pet profile first before viewing records.</p>
            <a href="/api/create-pet-profile" class="btn btn-primary">
              <i data-lucide="plus"></i> Add New Pet
            </a>
          </div>
        <% } %>
      </div>
    </section>

    <footer>
      <div class="container footer-container">
        <div class="footer-brand">
          <h2>Woofy.</h2>
          <p>Premium PetCare.</p>
        </div>
        <div class="footer-links">
          <p>
            <b>Created By</b>

            <a
              class="linkedin"
              href="https://linkedin.com/in/shubham-rathod-tech"
            >
              Shubham Rathod - Jimmy
            </a>
          </p>
        </div>
      </div>
    </footer>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="/My-Pets/my-pets.js"></script>
  </body>
</html>
