<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pets | Woofy | Pet Health & Management Platform</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/My-Pets/my-pets.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Ambient Background Lighting Mesh (Contained) -->
    <div class="ambient-glow-wrapper" aria-hidden="true">
      <div class="ambient-glow glow-1"></div>
      <div class="ambient-glow glow-2"></div>
    </div>

    <!-- Sticky Glassmorphic Navbar -->
    <%- include('../partials/navbar', { activePage: 'pets' }) %>

    <main class="pets-page">
      <div class="container">
        <!-- Flash Messages -->
        <%- include('../partials/flash-messages') %>

        <div class="pets-header">
          <div class="pets-header-text">
            <span class="page-badge-pill">Pet Parent Workspace</span>
            <h2>My Registered <span class="sketch-highlight">Pets</span></h2>
            <p>Manage individual pet profiles, growth charts, automated vaccination schedules, and medical tracking logs.</p>
          </div>
          <div class="pets-header-actions">
            <a href="/api/create-pet-profile" class="btn btn-add-pet">
              <i data-lucide="plus-circle" style="width: 18px; height: 18px;"></i>
              <span>Add New Pet</span>
            </a>
          </div>
        </div>

        <% if (typeof pets !== 'undefined' && pets && pets.length > 0) { %>
          <div class="pets-grid">
            <% pets.forEach(function(pet) { %>
              <div class="pet-card">
                <div class="pet-card-top">
                  <% if (pet.photo) { %>
                    <img src="<%= pet.photo %>" alt="<%= pet.petName %>" class="pet-avatar-img" onerror="this.src='/uploads/pets/default-pet.png'" />
                  <% } else if (pet.photoUrl) { %>
                    <img src="<%= pet.photoUrl %>" alt="<%= pet.petName %>" class="pet-avatar-img" onerror="this.src='/uploads/pets/default-pet.png'" />
                  <% } else { %>
                    <div class="profile-avatar-fallback">
                      <%= pet.petName ? pet.petName.charAt(0).toUpperCase() : 'P' %>
                    </div>
                  <% } %>
                  <div class="pet-header-info">
                    <h3><%= pet.petName %></h3>
                    <p class="pet-sub">
                      <span class="pet-breed-tag"><%= pet.breed || pet.species || 'Pet' %></span>
                      <span class="pet-dot-separator">•</span>
                      <span class="pet-gender-tag"><%= pet.gender || 'Companion' %></span>
                    </p>
                  </div>
                </div>

                <div class="pet-card-stats">
                  <div class="stat">
                    <span class="stat-label">Age</span>
                    <span class="stat-value"><%= pet.age ? pet.age + ' yrs' : 'N/A' %></span>
                  </div>
                  <div class="stat">
                    <span class="stat-label">Weight</span>
                    <span class="stat-value"><%= pet.weight ? pet.weight + ' kg' : 'N/A' %></span>
                  </div>
                  <div class="stat">
                    <span class="stat-label">Vaccinated</span>
                    <span class="stat-value stat-vax <%= (pet.vaccinated === 'Yes' || pet.vaccinated === 'yes') ? 'vax-yes' : 'vax-no' %>">
                      <i data-lucide="<%= (pet.vaccinated === 'Yes' || pet.vaccinated === 'yes') ? 'check-circle' : 'alert-circle' %>" style="width: 13px; height: 13px;"></i>
                      <span><%= pet.vaccinated || 'Pending' %></span>
                    </span>
                  </div>
                </div>

                <!-- Structured Clear Action Buttons -->
                <div class="pet-card-actions">
                  <!-- Tier 1: Main Highlight Actions -->
                  <div class="actions-tier-primary">
                    <a href="/api/pet-profile/<%= pet._id %>" class="btn btn-action-profile" title="View <%= pet.petName %>'s Full Profile">
                      <i data-lucide="eye"></i>
                      <span>Profile</span>
                    </a>
                    <a href="/api/vaccinations/<%= pet._id %>" class="btn btn-action-vaccines" title="View <%= pet.petName %>'s Automated Vaccination Schedule">
                      <i data-lucide="syringe"></i>
                      <span>Vaccines</span>
                    </a>
                    <a href="/api/track/<%= pet._id %>" class="btn btn-action-track" title="Track <%= pet.petName %>'s Daily Health & Activity">
                      <i data-lucide="activity"></i>
                      <span>Track</span>
                    </a>
                  </div>

                  <!-- Tier 2: Quick Management Tools -->
                  <div class="actions-tier-secondary">
                    <a href="/api/pet-profile/<%= pet._id %>/print-tag" target="_blank" class="btn btn-action-tag" title="Print Smart QR Collar Tag">
                      <i data-lucide="qr-code"></i>
                      <span>QR Tag</span>
                    </a>
                    <a href="/api/show-records/<%= pet._id %>" class="btn btn-action-records" title="View Medical & Activity History">
                      <i data-lucide="clipboard-list"></i>
                      <span>Records</span>
                    </a>
                    <a href="/api/pet-profile/edit/<%= pet._id %>" class="btn btn-action-edit" title="Edit <%= pet.petName %>'s Profile">
                      <i data-lucide="edit-3"></i>
                      <span>Edit</span>
                    </a>
                    <form action="/api/pet-profile/delete/<%= pet._id %>" method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete <%= pet.petName %>\'s profile? This action will remove all recorded logs.');">
                      <button type="submit" class="btn btn-action-delete" title="Delete <%= pet.petName %>">
                        <i data-lucide="trash-2"></i>
                        <span>Delete</span>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-pets-box">
            <div class="empty-pets-icon">
              <i data-lucide="paw-print"></i>
            </div>
            <h3>No Pets Registered Yet</h3>
            <p>Add your first furry companion to start tracking their growth, automated vaccination schedules, daily activities, and medical prescriptions.</p>
            <a href="/api/create-pet-profile" class="btn btn-add-pet">
              <i data-lucide="plus-circle"></i>
              <span>Add Your First Furry Companion</span>
            </a>
          </div>
        <% } %>
      </div>
    </main>

    <!-- Global Universal Footer Partial -->
    <%- include('../partials/footer') %>

    <!-- Scripts -->
    <script src="/My-Pets/my-pets.js"></script>
    <script>
      if (window.lucide) {
        lucide.createIcons();
      }
    </script>
  </body>
</html>
