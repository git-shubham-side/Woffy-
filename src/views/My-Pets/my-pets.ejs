<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pets | Woofy | Pet Health & Management Platform</title>

    <!-- Brand Identity & Mobile Meta -->
    <meta name="theme-color" content="#ea580c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/Images/Brand-Logo/brand.logo.png" />
    <link rel="apple-touch-icon" href="/Images/Brand-Logo/brand.logo.png" />

    <!-- Google Fonts: Inter & Plus Jakarta Sans (matching Landing Page) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/My-Pets/my-pets.css?v=3" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Ambient Background Lighting Mesh -->
    <div class="ambient-glow-wrapper" aria-hidden="true">
      <div class="ambient-glow glow-1"></div>
      <div class="ambient-glow glow-2"></div>
    </div>

    <!-- Sticky Glassmorphic Navbar -->
    <%- include('../partials/navbar', { activePage: 'pets' }) %>

    <main class="pets-page">
      <div class="container">
        <!-- Flash Messages -->
        <%- include('../partials/flash-messages') %>

        <%
          const petList = (typeof pets !== 'undefined' && pets) ? pets : [];
          const safeCount = petList.filter(p => !p.isLost).length;
          const tagCount = petList.filter(p => p.collarId).length;
          const vaxCount = petList.filter(p => (p.vaccinated || '').toLowerCase() === 'yes').length;
        %>

        <!-- Page Hero Banner (Landing Page Theme) -->
        <div class="pets-hero-banner">
          <div class="pets-hero-content">
            <div class="hero-kicker-pill">
              <i data-lucide="sparkles"></i>
              <span>Smart Pet Health &amp; Identity Console</span>
            </div>
            <h2>My Registered <span class="sketch-highlight">Pets</span></h2>
            <p>Manage digital medical records, generate printable QR collar tags, track vaccinations, and monitor daily health logs in one unified workspace.</p>
          </div>
          <div class="pets-hero-actions">
            <a href="/api/create-pet-profile" class="btn-pill btn-pill-coral">
              <i data-lucide="plus-circle"></i>
              <span>Add New Pet</span>
            </a>
          </div>
        </div>

        <% if (petList.length > 0) { %>
          <!-- Summary Metrics Cards Grid -->
          <div class="summary-metrics-grid">
            <div class="metric-tile">
              <div class="metric-tile-header">
                <span class="metric-title">Registered Pets</span>
                <div class="metric-icon-wrap icon-blue">
                  <i data-lucide="paw-print"></i>
                </div>
              </div>
              <div class="metric-value-row">
                <span class="metric-number"><%= petList.length %></span>
                <span class="metric-unit"><%= petList.length === 1 ? 'Profile' : 'Profiles' %> Active</span>
              </div>
              <div class="metric-tile-footer">
                <span class="metric-sub-green">
                  <span class="pulse-dot-green"></span>
                  <%= safeCount %> Safe at Home
                </span>
              </div>
            </div>

            <div class="metric-tile">
              <div class="metric-tile-header">
                <span class="metric-title">Home Safety</span>
                <div class="metric-icon-wrap icon-emerald">
                  <i data-lucide="shield-check"></i>
                </div>
              </div>
              <div class="metric-value-row">
                <span class="metric-number"><%= safeCount %></span>
                <span class="metric-unit">Companions Safe</span>
              </div>
              <div class="metric-tile-footer">
                <span class="metric-sub-slate">Emergency GPS Ready</span>
              </div>
            </div>

            <div class="metric-tile">
              <div class="metric-tile-header">
                <span class="metric-title">Collar QR Tags</span>
                <div class="metric-icon-wrap icon-blue">
                  <i data-lucide="qr-code"></i>
                </div>
              </div>
              <div class="metric-value-row">
                <span class="metric-number"><%= tagCount %></span>
                <span class="metric-unit">/<%= petList.length %> Issued</span>
              </div>
              <div class="metric-tile-footer">
                <span class="metric-sub-slate">Print-ready sheets</span>
              </div>
            </div>

            <div class="metric-tile">
              <div class="metric-tile-header">
                <span class="metric-title">Vaccine Coverage</span>
                <div class="metric-icon-wrap icon-emerald">
                  <i data-lucide="syringe"></i>
                </div>
              </div>
              <div class="metric-value-row">
                <span class="metric-number"><%= vaxCount %></span>
                <span class="metric-unit">/<%= petList.length %> Up to Date</span>
              </div>
              <div class="metric-tile-footer">
                <a href="/api/vaccinations" class="metric-link">WSAVA Protocol &rarr;</a>
              </div>
            </div>
          </div>

          <div class="pets-grid">
            <% petList.forEach(function(pet) { %>
              <div class="pet-card">
                <div class="pet-card-top">
                  <div class="pet-avatar-wrapper">
                    <% if (pet.photo) { %>
                      <img src="<%= pet.photo %>" alt="<%= pet.petName %>" class="pet-avatar-img" onerror="this.src='/uploads/pets/default-pet.png'" />
                    <% } else if (pet.photoUrl) { %>
                      <img src="<%= pet.photoUrl %>" alt="<%= pet.petName %>" class="pet-avatar-img" onerror="this.src='/uploads/pets/default-pet.png'" />
                    <% } else { %>
                      <div class="profile-avatar-fallback">
                        <%= pet.petName ? pet.petName.charAt(0).toUpperCase() : 'P' %>
                      </div>
                    <% } %>
                  </div>
                  <div class="pet-header-info">
                    <div class="pet-name-row">
                      <h3><%= pet.petName %></h3>
                      <span class="pet-status-pill <%= pet.isLost ? 'status-lost' : 'status-safe' %>">
                        <span class="status-dot"></span>
                        <%= pet.isLost ? 'Lost Alert' : 'Safe at Home' %>
                      </span>
                    </div>
                    <p class="pet-sub">
                      <span class="pet-breed-tag"><%= pet.breed || pet.species || 'Companion' %></span>
                      <span class="pet-dot-separator">•</span>
                      <span class="pet-gender-tag"><%= pet.gender || 'Companion' %></span>
                    </p>
                  </div>
                </div>

                <div class="pet-card-stats">
                  <div class="stat">
                    <span class="stat-label">Age</span>
                    <span class="stat-value"><%= pet.age ? pet.age + ' yrs' : 'N/A' %></span>
                  </div>
                  <div class="stat">
                    <span class="stat-label">Weight</span>
                    <span class="stat-value"><%= pet.weight ? pet.weight + ' kg' : 'N/A' %></span>
                  </div>
                  <div class="stat">
                    <span class="stat-label">Vaccinated</span>
                    <span class="stat-value stat-vax <%= (pet.vaccinated === 'Yes' || pet.vaccinated === 'yes') ? 'vax-yes' : 'vax-no' %>">
                      <i data-lucide="<%= (pet.vaccinated === 'Yes' || pet.vaccinated === 'yes') ? 'check-circle-2' : 'alert-circle' %>"></i>
                      <span><%= pet.vaccinated || 'Pending' %></span>
                    </span>
                  </div>
                </div>

                <!-- QR Collar Tag Strip Box -->
                <div class="pet-collar-tag-box">
                  <div class="collar-info-left">
                    <i data-lucide="qr-code"></i>
                    <div>
                      <span class="collar-label">Collar Tag ID</span>
                      <span class="collar-code"><%= pet.collarId || 'WF-TAG' %></span>
                    </div>
                  </div>
                  <a href="/api/pet-profile/<%= pet._id %>/print-tag" target="_blank" class="btn-print-tag" title="Print Smart QR Tag">
                    <i data-lucide="printer"></i>
                    <span>Print Sheet</span>
                  </a>
                </div>

                <!-- Action Buttons -->
                <div class="pet-card-actions">
                  <a href="/api/pet-profile/<%= pet._id %>" class="btn-pill btn-pill-coral btn-block" title="View Full Profile">
                    <span>View Health Passport &amp; Profile</span>
                    <i data-lucide="arrow-right"></i>
                  </a>

                  <div class="actions-tier-secondary">
                    <a href="/api/vaccinations/<%= pet._id %>" class="btn-tool-pill" title="Vaccinations">
                      <i data-lucide="syringe" style="color: #2563eb;"></i>
                      <span>Vaccines</span>
                    </a>
                    <a href="/api/track/<%= pet._id %>" class="btn-tool-pill" title="Daily Tracking Logs">
                      <i data-lucide="activity" style="color: #10b981;"></i>
                      <span>Logs</span>
                    </a>
                    <a href="/api/pet-profile/edit/<%= pet._id %>" class="btn-tool-pill" title="Edit Profile">
                      <i data-lucide="edit-3"></i>
                      <span>Edit</span>
                    </a>
                    <form action="/api/pet-profile/delete/<%= pet._id %>" method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete <%= pet.petName %>\'s profile? All associated health records will be permanently removed.');">
                      <button type="submit" class="btn-tool-pill btn-delete-tool" title="Delete Pet">
                        <i data-lucide="trash-2"></i>
                        <span>Delete</span>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-pets-box">
            <div class="empty-pets-icon">
              <i data-lucide="paw-print"></i>
            </div>
            <h3>No Pets Registered Yet</h3>
            <p>Add your first furry companion to start tracking their growth, automated vaccination schedules, daily activities, and printable emergency QR tags.</p>
            <a href="/api/create-pet-profile" class="btn-pill btn-pill-coral">
              <i data-lucide="plus-circle"></i>
              <span>Add Your First Furry Companion</span>
            </a>
          </div>
        <% } %>
      </div>
    </main>

    <!-- Global Universal Footer Partial -->
    <%- include('../partials/footer') %>

    <!-- Scripts -->
    <script src="/My-Pets/my-pets.js"></script>
    <script>
      if (window.lucide) {
        lucide.createIcons();
      }
    </script>
  </body>
</html>
