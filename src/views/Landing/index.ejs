<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Woofy — Complete Pet Health & Emergency Care Platform</title>
    <meta name="description" content="Manage your pet's medical records, upload prescriptions, locate verified 24/7 emergency pet hospitals near you, and connect with animal rescue helplines." />

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/Landing/style.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Subtle Background Ambient Light (Minimalist & Non-intrusive) -->
    <div class="bg-mesh" aria-hidden="true">
      <div class="mesh-blob blob-1"></div>
      <div class="mesh-blob blob-2"></div>
      <div class="mesh-grid-pattern"></div>
    </div>

    <!-- Navigation Header -->
    <header id="navbar">
      <div class="container nav-container">
        <a href="/" class="brand-logo" aria-label="Woofy Home">
          <span class="logo-icon-box">
            <i data-lucide="paw-print"></i>
          </span>
          <span class="brand-name">Woofy<span class="dot">.</span></span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="nav-links" aria-label="Main Navigation">
          <a href="#home" class="nav-link active">Home</a>
          <a href="#services" class="nav-link">Services</a>
          <a href="#how-it-works" class="nav-link">How It Works</a>
          <a href="#why-us" class="nav-link">Why Us</a>
          <a href="/services/hospitals" class="nav-link">Hospitals</a>
          <a href="/services/rescue" class="nav-link">Rescue NGO</a>
          <a href="/shop" class="nav-link">Pet Shop</a>
          <a href="#contact" class="nav-link">Contact</a>
        </nav>

        <!-- Right Side Auth CTA & Mobile Toggle -->
        <div class="nav-actions">
          <a href="/api/login" class="btn btn-ghost btn-sm">Log In</a>
          <a href="/api/signup" class="btn btn-primary btn-sm btn-nav-cta">
            <span>Get Started</span>
            <i data-lucide="arrow-right" class="btn-icon"></i>
          </a>

          <!-- Mobile Hamburger Menu Button -->
          <button
            type="button"
            class="mobile-menu-btn"
            id="mobileMenuToggle"
            aria-label="Toggle Navigation Menu"
            aria-expanded="false"
          >
            <i data-lucide="menu" id="menuOpenIcon"></i>
            <i data-lucide="x" id="menuCloseIcon" style="display: none;"></i>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Drawer Overlay & Menu -->
    <div class="mobile-drawer-overlay" id="mobileDrawerOverlay" aria-hidden="true"></div>
    <aside class="mobile-drawer" id="mobileDrawer" aria-label="Mobile Navigation">
      <div class="mobile-drawer-header">
        <a href="/" class="brand-logo">
          <span class="logo-icon-box">
            <i data-lucide="paw-print"></i>
          </span>
          <span class="brand-name">Woofy<span class="dot">.</span></span>
        </a>
        <button type="button" class="drawer-close-btn" id="drawerCloseBtn" aria-label="Close menu">
          <i data-lucide="x"></i>
        </button>
      </div>

      <nav class="mobile-drawer-links">
        <a href="#home" class="drawer-link"><i data-lucide="home"></i> <span>Home</span></a>
        <a href="#services" class="drawer-link"><i data-lucide="grid"></i> <span>Services & Features</span></a>
        <a href="#how-it-works" class="drawer-link"><i data-lucide="layers"></i> <span>How It Works</span></a>
        <a href="#why-us" class="drawer-link"><i data-lucide="shield-check"></i> <span>Why Choose Us</span></a>
        <a href="/services/hospitals" class="drawer-link"><i data-lucide="hospital"></i> <span>Nearby Hospitals</span></a>
        <a href="/services/rescue" class="drawer-link"><i data-lucide="heart-handshake"></i> <span>Rescue Helplines</span></a>
        <a href="/shop" class="drawer-link"><i data-lucide="shopping-bag"></i> <span>Pet Shop</span></a>
        <a href="#contact" class="drawer-link"><i data-lucide="mail"></i> <span>Contact Us</span></a>
      </nav>

      <div class="mobile-drawer-footer">
        <a href="/api/login" class="btn btn-secondary btn-full">Log In</a>
        <a href="/api/signup" class="btn btn-primary btn-full">
          <span>Create Free Account</span>
          <i data-lucide="arrow-right"></i>
        </a>
      </div>
    </aside>

    <main>
      <div class="container" style="padding-top: 1rem;">
        <%- include('../partials/flash-messages') %>
      </div>

      <!-- Hero Section -->
      <section id="home" class="hero-section">
        <div class="container hero-container">
          <!-- Left Column: Copy & CTAs -->
          <div class="hero-content">
            <div class="announcement-pill">
              <span class="live-pulse"></span>
              <span class="pill-text">Live 24/7 Verified Vet & Rescue Network</span>
              <i data-lucide="arrow-up-right" class="pill-arrow"></i>
            </div>

            <h1 class="hero-title">
              The Modern Platform for Your Pet's
              <span class="gradient-text">Health & Wellbeing.</span>
            </h1>

            <p class="hero-subtitle">
              Effortlessly track medical history, attach digital prescriptions, locate verified 24/7 emergency veterinary clinics, and access animal rescue helplines — all in one unified workspace.
            </p>

            <div class="hero-cta-group">
              <a href="/api/signup" class="btn btn-primary btn-lg">
                <span>Start Free Journey</span>
                <i data-lucide="arrow-right"></i>
              </a>
              <a href="/services/hospitals" class="btn btn-secondary btn-lg">
                <i data-lucide="map-pin"></i>
                <span>Find Nearby Hospitals</span>
              </a>
            </div>

            <!-- Social Proof Stack -->
            <div class="hero-social-proof">
              <div class="avatar-stack">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Pet Parent" />
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Pet Parent" />
                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=120&q=80" alt="Pet Parent" />
                <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=120&q=80" alt="Pet Parent" />
              </div>
              <div class="proof-details">
                <div class="star-rating">
                  <i data-lucide="star"></i>
                  <i data-lucide="star"></i>
                  <i data-lucide="star"></i>
                  <i data-lucide="star"></i>
                  <i data-lucide="star"></i>
                  <span class="rating-number">4.9 / 5.0</span>
                </div>
                <span class="proof-label">Trusted by 2,500+ pet parents across India</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Sharp UI Preview Widget -->
          <div class="hero-visual">
            <div class="ui-mockup-frame">
              <!-- Mockup Card Header -->
              <div class="mockup-header">
                <div class="mockup-controls">
                  <span class="control red"></span>
                  <span class="control yellow"></span>
                  <span class="control green"></span>
                </div>
                <div class="mockup-title">woofy.app / pet / rocky</div>
                <div class="mockup-status">
                  <span class="status-dot online"></span>
                  <span>Active Sync</span>
                </div>
              </div>

              <!-- Main Pet Health Card Preview -->
              <div class="mockup-body">
                <!-- Pet Profile Snippet -->
                <div class="mockup-pet-banner">
                  <div class="mockup-pet-avatar">
                    <img
                      src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=300&q=80"
                      alt="Golden Retriever - Rocky"
                    />
                  </div>
                  <div class="mockup-pet-info">
                    <div class="pet-name-row">
                      <h3>Rocky</h3>
                      <span class="breed-tag">Golden Retriever</span>
                    </div>
                    <p class="pet-submeta">Male • 2 Years 4 Months • Microchipped</p>
                  </div>
                  <div class="health-badge-pill">
                    <i data-lucide="check-circle-2"></i>
                    <span>Vitals Optimal</span>
                  </div>
                </div>

                <!-- Quick Vitals Grid -->
                <div class="mockup-vitals-grid">
                  <div class="vital-card">
                    <span class="vital-label">Weight</span>
                    <span class="vital-val">28.4 <small>kg</small></span>
                    <span class="vital-trend positive">↑ +0.3 kg this month</span>
                  </div>
                  <div class="vital-card">
                    <span class="vital-label">Rabies Booster</span>
                    <span class="vital-val">Up to date</span>
                    <span class="vital-trend neutral">Next: Nov 2026</span>
                  </div>
                  <div class="vital-card">
                    <span class="vital-label">Daily Diet</span>
                    <span class="vital-val">420 <small>kcal/day</small></span>
                    <span class="vital-trend positive">✓ On Schedule</span>
                  </div>
                </div>

                <!-- Live Notification Preview -->
                <div class="mockup-alert-chip">
                  <div class="alert-chip-icon">
                    <i data-lucide="file-check-2"></i>
                  </div>
                  <div class="alert-chip-content">
                    <strong>Prescription Attached</strong>
                    <span>Dr. Sharma • Apollo Pet Care Clinic</span>
                  </div>
                  <span class="chip-time">Today, 11:30 AM</span>
                </div>

                <!-- Emergency SOS Quick Access -->
                <div class="mockup-emergency-bar">
                  <div class="emergency-text">
                    <i data-lucide="ambulance"></i>
                    <span>Nearest Verified 24/7 Vet Hospital: <strong>1.8 km away</strong></span>
                  </div>
                  <a href="/services/hospitals" class="emergency-action-btn">
                    <span>Call Vet</span>
                    <i data-lucide="phone-call"></i>
                  </a>
                </div>
              </div>
            </div>

            <!-- Floating Micro Accent Badges -->
            <div class="floating-chip chip-top">
              <div class="chip-icon bg-blue">
                <i data-lucide="shield-check"></i>
              </div>
              <div class="chip-text">
                <strong>100% Verified</strong>
                <span>Authentic Veterinary Data</span>
              </div>
            </div>

            <div class="floating-chip chip-bottom">
              <div class="chip-icon bg-emerald">
                <i data-lucide="activity"></i>
              </div>
              <div class="chip-text">
                <strong>Instant Geocoding</strong>
                <span>Auto-detects closest clinic</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Metrics Ribbon Banner -->
      <section class="stats-section">
        <div class="container">
          <div class="stats-ribbon reveal">
            <div class="stats-grid">
              <div class="stat-item">
                <div class="stat-number">100<span class="stat-symbol">%</span></div>
                <div class="stat-label">Verified Pet Hospitals</div>
                <div class="stat-desc">Authentic contact numbers & GPS pins</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">24<span class="stat-symbol">/7</span></div>
                <div class="stat-label">Emergency Helpline</div>
                <div class="stat-desc">Rapid animal rescue NGO access</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">30<span class="stat-symbol">+</span></div>
                <div class="stat-label">Indian Cities</div>
                <div class="stat-desc">Pan-India coverage & expansion</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">4.9<span class="stat-symbol">★</span></div>
                <div class="stat-label">Pet Parent Rating</div>
                <div class="stat-desc">Based on verified user feedback</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Platform Core Services & Bento Features Grid -->
      <section id="services" class="section services-section">
        <div class="container">
          <div class="section-header reveal">
            <span class="section-badge">Platform Capabilities</span>
            <h2 class="section-title">Built for Every Stage of Your Pet's Life</h2>
            <p class="section-description">
              A complete suite of modern pet care tools designed with clean aesthetics, instant accessibility, and zero clutter.
            </p>
          </div>

          <div class="bento-services-grid">
            <!-- Bento Card 1: Health Tracking (Large Feature) -->
            <div class="bento-card bento-hero-card reveal">
              <div class="bento-card-content">
                <div class="bento-icon icon-blue">
                  <i data-lucide="clipboard-plus"></i>
                </div>
                <span class="card-kicker">Health & Growth Vault</span>
                <h3 class="card-heading">Digital Pet Medical Passport</h3>
                <p class="card-paragraph">
                  Log routine vaccinations, allergy histories, medication schedules, weight logs, and attach official doctor prescription slips directly to cloud records.
                </p>
                <div class="card-feature-list">
                  <span class="feature-chip"><i data-lucide="check"></i> Prescription Scans</span>
                  <span class="feature-chip"><i data-lucide="check"></i> Weight Charts</span>
                  <span class="feature-chip"><i data-lucide="check"></i> Vaccine History</span>
                </div>
                <a href="/api/signup" class="bento-link">
                  <span>Start Tracking Health</span>
                  <i data-lucide="arrow-right"></i>
                </a>
              </div>
              <div class="bento-visual visual-health">
                <div class="mini-ui-card">
                  <div class="mini-ui-row">
                    <span class="mini-tag">Vaccination Record</span>
                    <span class="mini-status done">Completed</span>
                  </div>
                  <div class="mini-medicine">DHPP Booster & Rabies</div>
                  <div class="mini-meta">Attached: <span class="text-blue">prescription_dr_roy.pdf</span></div>
                </div>
              </div>
            </div>

            <!-- Bento Card 2: 24/7 Verified Hospitals -->
            <div class="bento-card reveal">
              <div class="bento-icon icon-amber">
                <i data-lucide="hospital"></i>
              </div>
              <span class="card-kicker">Geocoded Directory</span>
              <h3 class="card-heading">24/7 Verified Hospitals</h3>
              <p class="card-paragraph">
                Auto-detect your real-time coordinates and discover verified veterinary clinics and emergency hospitals sorted by proximity in kilometers with instant call & GPS directions.
              </p>
              <a href="/services/hospitals" class="bento-link">
                <span>Explore Nearby Hospitals</span>
                <i data-lucide="arrow-right"></i>
              </a>
            </div>

            <!-- Bento Card 3: Animal Rescue Helplines -->
            <div class="bento-card reveal">
              <div class="bento-icon icon-emerald">
                <i data-lucide="heart-handshake"></i>
              </div>
              <span class="card-kicker">Emergency Network</span>
              <h3 class="card-heading">Rescue NGOs & Helplines</h3>
              <p class="card-paragraph">
                Find contact numbers for verified animal rescue NGOs, stray ambulances, shelter homes, and adoption coordinates filtered by Indian metropolitan regions.
              </p>
              <a href="/services/rescue" class="bento-link">
                <span>View Rescue Directory</span>
                <i data-lucide="arrow-right"></i>
              </a>
            </div>

            <!-- Bento Card 4: Curated Pet Essentials Store -->
            <div class="bento-card bento-wide-card reveal">
              <div class="bento-card-content">
                <div class="bento-icon icon-violet">
                  <i data-lucide="shopping-bag"></i>
                </div>
                <span class="card-kicker">Curated Marketplace</span>
                <h3 class="card-heading">Pet Essentials & Nutrition Shop</h3>
                <p class="card-paragraph">
                  Browse veterinarian-recommended nutrition kibbles, grooming care, tough chew toys, and wellness supplements tailored for Indian breeds.
                </p>
                <div class="card-feature-list">
                  <span class="feature-chip"><i data-lucide="check"></i> Verified Brands</span>
                  <span class="feature-chip"><i data-lucide="check"></i> Breed-Specific Diet</span>
                  <span class="feature-chip"><i data-lucide="check"></i> Direct Order</span>
                </div>
                <a href="/shop" class="bento-link">
                  <span>Browse Pet Shop Catalog</span>
                  <i data-lucide="arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3-Step "How It Works" Section -->
      <section id="how-it-works" class="section how-it-works-section">
        <div class="container">
          <div class="section-header reveal">
            <span class="section-badge">Simple Workflow</span>
            <h2 class="section-title">How Woofy Powers Your Pet Care</h2>
            <p class="section-description">
              Getting started takes less than 60 seconds. Set up your pet profile and gain instant control over their health.
            </p>
          </div>

          <div class="workflow-steps-grid">
            <div class="step-card reveal">
              <div class="step-header">
                <span class="step-number">01</span>
                <div class="step-icon">
                  <i data-lucide="user-check"></i>
                </div>
              </div>
              <h3 class="step-title">Create Pet Profile</h3>
              <p class="step-desc">
                Register your dog's breed, birthday, weight, allergies, and upload high-resolution profile avatars and memories.
              </p>
            </div>

            <div class="step-card reveal">
              <div class="step-header">
                <span class="step-number">02</span>
                <div class="step-icon">
                  <i data-lucide="file-spreadsheet"></i>
                </div>
              </div>
              <h3 class="step-title">Log Vitals & Records</h3>
              <p class="step-desc">
                Record routine medical checkups, attach scanned prescriptions, set upcoming vaccine reminders, and log daily progress.
              </p>
            </div>

            <div class="step-card reveal">
              <div class="step-header">
                <span class="step-number">03</span>
                <div class="step-icon">
                  <i data-lucide="crosshair"></i>
                </div>
              </div>
              <h3 class="step-title">Access 24/7 Verified Care</h3>
              <p class="step-desc">
                Instantly discover emergency clinics near your current city with one-tap dialing and turnkey turn-by-turn directions.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Why Us / Core Platform Pillars -->
      <section id="why-us" class="section why-us-section">
        <div class="container">
          <div class="section-header reveal">
            <span class="section-badge">Engineered for Reliability</span>
            <h2 class="section-title">Why Serious Pet Parents Choose Woofy</h2>
            <p class="section-description">
              Modern cloud architecture engineered with speed, bulletproof security, and seamless mobile usability.
            </p>
          </div>

          <div class="pillars-grid">
            <div class="pillar-card reveal">
              <div class="pillar-icon"><i data-lucide="map-pinned"></i></div>
              <h4>Smart GPS Geocoding</h4>
              <p>Reverse geocodes your device coordinates to calculate accurate distances to veterinary centers in real-time.</p>
            </div>

            <div class="pillar-card reveal">
              <div class="pillar-icon"><i data-lucide="file-up"></i></div>
              <h4>Cloud Prescription Vault</h4>
              <p>Never lose a physical clinic slip again. Store high-resolution medical invoices and prescriptions on secure cloud storage.</p>
            </div>

            <div class="pillar-card reveal">
              <div class="pillar-icon"><i data-lucide="layers"></i></div>
              <h4>Multi-Pet Management</h4>
              <p>Switch between multiple pets in a single tap with individualized health records and distinct timelines.</p>
            </div>

            <div class="pillar-card reveal">
              <div class="pillar-icon"><i data-lucide="lock"></i></div>
              <h4>Enterprise Security</h4>
              <p>State-of-the-art bcrypt password hashing, MongoDB security, and isolated user sessions keep data private.</p>
            </div>

            <div class="pillar-card reveal">
              <div class="pillar-icon"><i data-lucide="shield-alert"></i></div>
              <h4>Direct Emergency Helpline</h4>
              <p>Direct access to verified NGOs and ambulance providers without intermediaries when seconds count.</p>
            </div>

            <div class="pillar-card reveal">
              <div class="pillar-icon"><i data-lucide="smartphone"></i></div>
              <h4>Zero App Store Friction</h4>
              <p>Full PWA responsiveness that loads instantly on any iPhone, Android, tablet, or desktop browser.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Testimonials / Pet Parent Reviews -->
      <section class="section testimonials-section">
        <div class="container">
          <div class="section-header reveal">
            <span class="section-badge">Community Trust</span>
            <h2 class="section-title">Loved by Dog Owners Everywhere</h2>
            <p class="section-description">
              Hear from genuine pet parents who trust Woofy for their companion's daily health tracking and emergency care.
            </p>
          </div>

          <div class="testimonials-grid">
            <div class="testimonial-card reveal">
              <div class="testimonial-rating">
                <i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i>
              </div>
              <p class="testimonial-quote">
                "During a midnight emergency with my Labrador, Woofy's hospital finder showed me a verified 24/7 clinic just 2 km away with one-tap calling. It was a lifesaver."
              </p>
              <div class="testimonial-author">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Ananya Deshmukh" />
                <div>
                  <h5>Ananya Deshmukh</h5>
                  <span>Mumbai • Labrador Parent</span>
                </div>
              </div>
            </div>

            <div class="testimonial-card reveal">
              <div class="testimonial-rating">
                <i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i>
              </div>
              <p class="testimonial-quote">
                "Being able to attach doctor prescription photos directly to my beagle's vaccine records means I never scramble for old paper slips at vet visits anymore."
              </p>
              <div class="testimonial-author">
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Rohit Verma" />
                <div>
                  <h5>Rohit Verma</h5>
                  <span>Bengaluru • Beagle Parent</span>
                </div>
              </div>
            </div>

            <div class="testimonial-card reveal">
              <div class="testimonial-rating">
                <i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i>
              </div>
              <p class="testimonial-quote">
                "The UI is exceptionally crisp and fast on mobile. Finding rescue helplines for injured strays in our locality took just two taps. Outstanding work!"
              </p>
              <div class="testimonial-author">
                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=120&q=80" alt="Pooja Mehta" />
                <div>
                  <h5>Pooja Mehta</h5>
                  <span>Pune • Indie Dog Parent</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact Us & Creator Showcase Section -->
      <section id="contact" class="section contact-section">
        <div class="container">
          <div class="section-header reveal">
            <span class="section-badge">Get in Touch</span>
            <h2 class="section-title">Let's Connect & Collaborate</h2>
            <p class="section-description">
              Have feedback, hospital listing inquiries, feature requests, or partnership proposals? We are always here to help.
            </p>
          </div>

          <div class="contact-grid">
            <!-- Creator Profile Card -->
            <div class="creator-card reveal">
              <div class="creator-header">
                <div class="creator-avatar-wrap">
                  <img
