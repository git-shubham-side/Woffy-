<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Records | Woofy Premium Pet Care</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- External CSS -->
    <link rel="stylesheet" href="/View-Record/view-record.css" />

    <!-- Lucide Icons Script -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Top Navigation -->
    <%- include('../partials/navbar', { activePage: 'pets' }) %>

    <main class="dashboard-main container">
      <!-- Flash Messages -->
      <%- include('../partials/flash-messages') %>

      <!-- Breadcrumb & Header -->
      <a href="/api/select-pet-to-show-record" class="back-link"
        ><i data-lucide="arrow-left" style="width: 16px; height: 16px"></i> Back
        to Pet Selection</a
      >

      <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
          <h1>All Records for <%= typeof pet !== 'undefined' && pet ? pet.petName : 'Pet' %></h1>
          <p>View and filter complete health, medication, and care history.</p>
        </div>
        <% if (typeof pet !== 'undefined' && pet) { %>
          <a href="/api/track/<%= pet._id %>" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px;">
            <i data-lucide="plus" style="width: 16px; height: 16px;"></i> Add New Log
          </a>
        <% } %>
      </div>

      <!-- Category Filters -->
      <div class="filter-container">
        <button class="filter-btn active" data-category="all">
          All Records
        </button>
        <button class="filter-btn" data-category="weight">Weight</button>
        <button class="filter-btn" data-category="medical">Medical</button>
        <button class="filter-btn" data-category="medicine">Medicine</button>
        <button class="filter-btn" data-category="vet_history">Vet History</button>
        <button class="filter-btn" data-category="grooming">Grooming</button>
        <button class="filter-btn" data-category="bath">Bath</button>
      </div>

      <!-- Records List Container -->
      <div class="records-list" id="recordsList">
        <% if (typeof records !== 'undefined' && records.length > 0) { %>
          <% records.forEach(function(rec) { %>
            <div class="record-item" data-category="<%= rec.activityType %>">
              <div class="record-summary">
                <div class="record-icon">
                  <% if (rec.activityType === 'weight') { %>
                    <i data-lucide="scale" style="color: #0369a1"></i>
                  <% } else if (rec.activityType === 'medical') { %>
                    <i data-lucide="stethoscope" style="color: #991b1b"></i>
                  <% } else if (rec.activityType === 'medicine') { %>
                    <i data-lucide="pill" style="color: #1e40af"></i>
                  <% } else if (rec.activityType === 'vet_history') { %>
                    <i data-lucide="clipboard-list" style="color: #065f46"></i>
                  <% } else if (rec.activityType === 'grooming') { %>
                    <i data-lucide="scissors" style="color: #7c3aed"></i>
                  <% } else { %>
                    <i data-lucide="droplets" style="color: #0284c7"></i>
                  <% } %>
                </div>
                <div class="record-info">
                  <h4 class="record-title"><%= rec.title %></h4>
                  <span class="badge badge-<%= rec.activityType %>"><%= rec.activityType.replace('_', ' ').toUpperCase() %></span>
                  <span class="record-date"><%= new Date(rec.date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %></span>
                </div>
                <button class="expand-btn" aria-label="Expand record">
                  <i data-lucide="chevron-down"></i>
                </button>
              </div>
              <div class="record-details">
                <p><%= rec.notes || 'No extra notes recorded for this activity.' %></p>
                <% if (rec.image) { %>
                  <div style="margin: 1rem 0;">
                    <p style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem; display: flex; align-items: center; gap: 4px;">
                      <i data-lucide="image" style="width: 14px; height: 14px;"></i> Attached Photo / Prescription:
                    </p>
                    <a href="<%= rec.image %>" target="_blank" style="display: inline-block;">
                      <img src="<%= rec.image %>" alt="Record Attachment" style="max-width: 240px; max-height: 180px; border-radius: 6px; border: 1px solid var(--border-color); object-fit: cover; display: block;" />
                    </a>
                  </div>
                <% } %>
                <form action="/api/records/delete/<%= rec._id %>" method="POST" style="margin-top: 1rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;" onsubmit="return confirm('Are you sure you want to delete this record?');">
                  <% if (typeof pet !== 'undefined' && pet) { %>
                    <input type="hidden" name="petId" value="<%= pet._id %>" />
                  <% } %>
                  <button type="submit" class="btn btn-danger btn-sm">
                    <i data-lucide="trash-2"></i> Delete Log
                  </button>
                </form>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div style="text-align: center; padding: 4rem 2rem; background: var(--white); border: 1px solid var(--border-color); border-radius: var(--border-radius);">
            <div style="color: var(--text-muted); margin-bottom: 1rem;">
              <i data-lucide="clipboard-list" style="width: 48px; height: 48px;"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: var(--primary-color);">No records logged yet</h3>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Start tracking weight, medical checkups, grooming, or medications for your pet.</p>
            <% if (typeof pet !== 'undefined' && pet) { %>
              <a href="/api/track/<%= pet._id %>" class="btn btn-primary">
                <i data-lucide="plus"></i> Add First Record
              </a>
            <% } %>
          </div>
        <% } %>
      </div>
    </main>

    <!-- Footer -->
    <footer class="dash-footer">
      <div class="container">
        <p>Woofy | Pet Management Application</p>
      </div>
    </footer>

    <!-- Filtering & Expansion Logic -->
    <script>
      // Initialize Icons
      lucide.createIcons();

      document.addEventListener("DOMContentLoaded", () => {
        const filterBtns = document.querySelectorAll(".filter-btn");
        const records = document.querySelectorAll(".record-item");
        const expandBtns = document.querySelectorAll(".expand-btn");

        // 1. Filtering Logic
        filterBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            // Remove active class from all buttons
            filterBtns.forEach((b) => b.classList.remove("active"));
            // Add active class to clicked button
            btn.classList.add("active");

            const selectedCategory = btn.getAttribute("data-category");

            // Show/Hide records based on category
            records.forEach((record) => {
              const recordCategory = record.getAttribute("data-category");
              if (
                selectedCategory === "all" ||
                recordCategory === selectedCategory
              ) {
                record.style.display = "block";
              } else {
                record.style.display = "none";
              }
            });
          });
        });

        // 2. Expand/Collapse Logic
        expandBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const recordItem = e.currentTarget.closest(".record-item");

            // Toggle the 'expanded' class
            recordItem.classList.toggle("expanded");
          });
        });
      });
    </script>
  </body>
</html>
