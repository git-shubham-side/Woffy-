<!-- Global Universal Navbar Partial -->
<link rel="stylesheet" href="/partials/navbar.css?v=2" />

<header class="dashboard-nav" id="navbar">
  <div class="global-nav-container">
    <!-- Brand Logo -->
    <a href="/api/dashboard" class="global-nav-logo">
      Woofy<span>.</span>
    </a>

    <!-- Desktop / Tablet Center Navigation Links -->
    <nav class="global-nav-links" aria-label="Main Navigation">
      <a href="/api/dashboard" class="<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>">
        <i data-lucide="layout-dashboard"></i>
        <span>Dashboard</span>
      </a>

      <a href="/api/pet-profiles" class="<%= (typeof activePage !== 'undefined' && (activePage === 'pets' || activePage === 'profile' || activePage === 'create-pet')) ? 'active' : '' %>">
        <i data-lucide="paw-print"></i>
        <span>My Pets</span>
      </a>

      <a href="/api/vaccinations" class="<%= (typeof activePage !== 'undefined' && activePage === 'vaccinations') ? 'active' : '' %>">
        <i data-lucide="syringe"></i>
        <span>Vaccinations</span>
        <% if (typeof dueVaccineCount !== 'undefined' && dueVaccineCount > 0) { %>
        <span class="global-nav-badge"><%= dueVaccineCount %></span>
        <% } %>
      </a>

      <a href="/services/hospitals" class="<%= (typeof activePage !== 'undefined' && activePage === 'hospitals') ? 'active' : '' %>">
        <i data-lucide="hospital"></i>
        <span>Hospitals</span>
      </a>

      <a href="/services/rescue" class="<%= (typeof activePage !== 'undefined' && activePage === 'rescue') ? 'active' : '' %>">
        <i data-lucide="heart-handshake"></i>
        <span>Rescue NGOs</span>
      </a>

      <a href="/shop" class="<%= (typeof activePage !== 'undefined' && activePage === 'shop') ? 'active' : '' %>">
        <i data-lucide="shopping-bag"></i>
        <span>Shop</span>
      </a>
    </nav>

    <!-- Desktop Action Buttons & Mobile Hamburger Toggle -->
    <div class="global-nav-actions">
      <% if (typeof isAdminUser !== 'undefined' && isAdminUser) { %>
      <a href="/admin" class="global-nav-btn global-btn-admin <%= (typeof activePage !== 'undefined' && activePage === 'admin') ? 'active' : '' %>">
        <i data-lucide="shield-check"></i>
        <span>Admin <% if (typeof pendingHospitalCount !== 'undefined' && pendingHospitalCount > 0) { %>(<%= pendingHospitalCount %>)<% } %></span>
      </a>
      <% } %>

      <a href="/settings" class="global-nav-btn global-btn-settings <%= (typeof activePage !== 'undefined' && activePage === 'settings') ? 'active' : '' %>" title="Account Settings">
        <i data-lucide="settings"></i>
        <span>Settings</span>
      </a>

      <a href="/logout" class="global-nav-btn global-btn-logout">
        <i data-lucide="log-out"></i>
        <span>Log out</span>
      </a>

      <!-- Mobile Hamburger Toggle Button -->
      <button class="global-mobile-toggle" id="globalNavToggle" aria-label="Toggle navigation menu" aria-expanded="false" type="button">
        <span class="icon-hamburger" aria-hidden="true">
          <i data-lucide="menu"></i>
        </span>
        <span class="icon-close" aria-hidden="true">
          <i data-lucide="x"></i>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Slide-out Drawer Menu -->
  <div class="global-mobile-drawer" id="globalNavDrawer">
    <nav class="global-mobile-links-stack">
      <a href="/api/dashboard" class="<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>">
        <i data-lucide="layout-dashboard"></i>
        <span>Dashboard</span>
      </a>

      <a href="/api/pet-profiles" class="<%= (typeof activePage !== 'undefined' && (activePage === 'pets' || activePage === 'profile' || activePage === 'create-pet')) ? 'active' : '' %>">
        <i data-lucide="paw-print"></i>
        <span>My Pets</span>
      </a>

      <a href="/api/vaccinations" class="<%= (typeof activePage !== 'undefined' && activePage === 'vaccinations') ? 'active' : '' %>">
        <i data-lucide="syringe"></i>
        <span>Vaccinations</span>
        <% if (typeof dueVaccineCount !== 'undefined' && dueVaccineCount > 0) { %>
        <span class="global-nav-badge" style="margin-left: 6px;"><%= dueVaccineCount %> Due</span>
        <% } %>
      </a>

      <a href="/services/hospitals" class="<%= (typeof activePage !== 'undefined' && activePage === 'hospitals') ? 'active' : '' %>">
        <i data-lucide="hospital"></i>
        <span>Hospitals</span>
      </a>

      <a href="/services/rescue" class="<%= (typeof activePage !== 'undefined' && activePage === 'rescue') ? 'active' : '' %>">
        <i data-lucide="heart-handshake"></i>
        <span>Rescue NGOs</span>
      </a>

      <a href="/api/dashboard#ngo-hub">
        <i data-lucide="building-2"></i>
        <span>Woffy for NGOs</span>
      </a>

      <a href="/shop" class="<%= (typeof activePage !== 'undefined' && activePage === 'shop') ? 'active' : '' %>">
        <i data-lucide="shopping-bag"></i>
        <span>Shop</span>
      </a>

      <% if (typeof isAdminUser !== 'undefined' && isAdminUser) { %>
      <a href="/admin" class="<%= (typeof activePage !== 'undefined' && activePage === 'admin') ? 'active' : '' %>">
        <i data-lucide="shield-check"></i>
        <span>Admin Portal <% if (typeof pendingHospitalCount !== 'undefined' && pendingHospitalCount > 0) { %>(<%= pendingHospitalCount %>)<% } %></span>
      </a>
      <% } %>

      <a href="/settings" class="<%= (typeof activePage !== 'undefined' && activePage === 'settings') ? 'active' : '' %>">
        <i data-lucide="settings"></i>
        <span>Account Settings</span>
      </a>

      <a href="/logout" style="color: #ef4444; margin-top: 6px; border-top: 1px solid #e2e8f0; padding-top: 10px;">
        <i data-lucide="log-out"></i>
        <span>Log out</span>
      </a>
    </nav>
  </div>
</header>

<!-- Global Navbar Self-Initialization Script -->
<script>
  (function() {
    function initGlobalNavbar() {
      if (window.lucide) {
        window.lucide.createIcons();
      }

      const toggle = document.getElementById("globalNavToggle") || document.getElementById("mobileNavToggle");
      const drawer = document.getElementById("globalNavDrawer") || document.getElementById("mobileNavDrawer");

      if (toggle && drawer && !toggle._hasListener) {
        toggle._hasListener = true;

        toggle.addEventListener("click", function(e) {
          e.stopPropagation();
          const isOpen = drawer.classList.contains("open");
          drawer.classList.toggle("open", !isOpen);
          toggle.classList.toggle("is-active", !isOpen);
          toggle.setAttribute("aria-expanded", !isOpen ? "true" : "false");
          if (window.lucide) window.lucide.createIcons();
        });

        document.addEventListener("click", function(e) {
          if (drawer.classList.contains("open") && !drawer.contains(e.target) && !toggle.contains(e.target)) {
            drawer.classList.remove("open");
            toggle.classList.remove("is-active");
            toggle.setAttribute("aria-expanded", "false");
          }
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initGlobalNavbar);
    } else {
      initGlobalNavbar();
    }
  })();
</script>
