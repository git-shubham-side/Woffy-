<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Track <%= typeof pet !== 'undefined' && pet ? pet.petName + "'s Activity" : 'Pet Activity' %> | Woofy</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/Track-Record-Form/tracking.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Navigation -->
    <header class="dashboard-nav">
      <div class="nav-container">
        <a href="/api/dashboard" class="logo">
          Woofy<span>.</span>
        </a>

        <nav class="nav-center-links">
          <a href="/api/dashboard">Dashboard</a>
          <a href="/api/pet-profiles">My Pets</a>
          <a href="/services/hospitals">Hospitals</a>
          <a href="/services/rescue">Rescue NGOs</a>
          <a href="/shop">Shop</a>
        </nav>

        <div class="nav-actions">
          <a href="/api/select-pet-for-tracking" class="btn btn-secondary btn-sm">
            <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
            <span>Switch Pet</span>
          </a>
        </div>
      </div>
    </header>

    <main class="dashboard-main container">
      <!-- Flash Messages -->
      <%- include('../partials/flash-messages') %>

      <!-- Breadcrumb & Header -->
      <a href="/api/select-pet-for-tracking" class="back-link">
        <i data-lucide="arrow-left" style="width: 15px; height: 15px;"></i>
        <span>Back to Pet Selection</span>
      </a>

      <div class="page-header">
        <div>
          <h1>Track <%= typeof pet !== 'undefined' && pet ? pet.petName + "'s Activity" : 'Pet Activity' %></h1>
          <p>Log growth weight, medical checkups, prescriptions, grooming, and wash schedules.</p>
        </div>
        <% if (typeof pet !== 'undefined' && pet) { %>
        <a href="/api/show-records/<%= pet._id %>" class="btn btn-secondary btn-sm">
          <i data-lucide="clipboard-list" style="width: 15px; height: 15px;"></i>
          <span>View All <%= pet.petName %>'s Records</span>
        </a>
        <% } %>
      </div>

      <!-- Main Layout Grid -->
      <div class="records-layout">
        <!-- LEFT SIDE: CLEAN TRACK RECORD FORM -->
        <section class="create-record-section">
          <form class="form-card" action="/api/track/create" method="POST" enctype="multipart/form-data">
            <h2>Add New Care Log</h2>

            <% if (typeof pet !== 'undefined' && pet) { %>
              <input type="hidden" name="petId" value="<%= pet._id %>" />
            <% } %>

            <!-- Activity Type -->
            <div class="form-group">
              <label class="form-label">Activity / Care Category *</label>
              <select name="activityType" class="form-select" required>
                <option value="" disabled selected>Select category...</option>
                <option value="weight">⚖️ Weight (Track Growth & Diet)</option>
                <option value="medical">🩺 Medical (Surgeries / Health check)</option>
                <option value="medicine">💊 Medicine (Dosages / Treatments)</option>
                <option value="vet_history">📋 Vet History (Doctor Slips & Prescriptions)</option>
                <option value="grooming">✂️ Grooming (Fur trim, Nails, Spa)</option>
                <option value="bath">💧 Bath (Wash schedule & Skin care)</option>
              </select>
            </div>

            <!-- Title / Measurement -->
            <div class="form-group">
              <label class="form-label">Measurement / Record Title *</label>
              <input
                type="text"
                name="title"
                class="form-control"
                placeholder="e.g. 24.5 kg, Deworming Pill, Rabies Booster"
                required
              />
            </div>

            <!-- Date -->
            <div class="form-group">
              <label class="form-label">Date *</label>
              <input
                type="date"
                name="date"
                class="form-control"
                required
                value="<%= new Date().toISOString().split('T')[0] %>"
              />
            </div>

            <!-- Attachment File -->
            <div class="form-group">
              <label class="form-label">Attach Doctor Slip / Prescription / Photo (Optional)</label>
              <input
                type="file"
                name="recordImage"
                class="form-control"
                accept="image/*"
                style="padding-top: 0.45rem;"
              />
              <span style="color: var(--text-muted); font-size: 0.775rem; display: block; margin-top: 0.25rem;">Upload prescription receipt, medicine packaging, or photo.</span>
            </div>

            <!-- Additional Notes -->
            <div class="form-group">
              <label class="form-label">Care Notes & Instructions</label>
              <textarea
                name="notes"
                class="form-control"
                placeholder="e.g. Given 1 tab after meals for 5 days, doctor advised rest, used anti-tick shampoo..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-block">
              <i data-lucide="check" style="width: 16px; height: 16px;"></i>
              <span>Save Activity Log</span>
            </button>
          </form>
        </section>

        <!-- RIGHT SIDE: RECENT LOGS TIMELINE -->
        <section class="view-records-section">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <h2 style="font-size: 1.25rem; margin: 0; color: var(--primary-color);">
              Recent Activity Timeline
            </h2>
          </div>

          <div class="records-list">
            <% if (typeof records !== 'undefined' && records.length > 0) { %>
              <% records.forEach(function(rec) { %>
                <div class="record-item">
                  <div class="record-icon">
                    <% if (rec.activityType === 'weight') { %>
                      <i data-lucide="scale" style="color: #0284c7"></i>
                    <% } else if (rec.activityType === 'medical') { %>
                      <i data-lucide="stethoscope" style="color: #dc2626"></i>
                    <% } else if (rec.activityType === 'medicine') { %>
                      <i data-lucide="pill" style="color: #2563eb"></i>
                    <% } else if (rec.activityType === 'vet_history') { %>
                      <i data-lucide="clipboard-list" style="color: #16a34a"></i>
                    <% } else if (rec.activityType === 'grooming') { %>
                      <i data-lucide="scissors" style="color: #9333ea"></i>
                    <% } else { %>
                      <i data-lucide="droplets" style="color: #0891b2"></i>
                    <% } %>
                  </div>
                  <div class="record-content">
                    <div class="record-header">
                      <span class="record-title"><%= rec.title %></span>
                      <span class="record-date">
                        <%= new Date(rec.date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                      </span>
                    </div>
                    <span class="badge badge-<%= rec.activityType %>"><%= rec.activityType.replace('_', ' ').toUpperCase() %></span>
                    <% if (rec.notes) { %>
                      <p class="record-desc" style="margin-top: 0.65rem">
                        <%= rec.notes %>
                      </p>
                    <% } %>
                    <% if (rec.image) { %>
                      <div style="margin-top: 0.65rem;">
                        <a href="<%= rec.image %>" target="_blank" style="display: inline-block;">
                          <img src="<%= rec.image %>" alt="Attached document" style="max-width: 140px; max-height: 90px; border-radius: 6px; border: 1px solid var(--border-color); object-fit: cover;" />
                        </a>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div style="text-align: center; padding: 3rem 1.5rem; background: var(--white); border: 1px solid var(--border-color); border-radius: var(--border-radius);">
                <div style="color: var(--text-muted); margin-bottom: 0.75rem;">
                  <i data-lucide="activity" style="width: 36px; height: 36px;"></i>
                </div>
                <h4 style="margin-bottom: 0.25rem; color: var(--primary-color);">No Activity Logs Yet</h4>
                <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Fill out the form on the left to add <%= typeof pet !== 'undefined' && pet ? pet.petName + "'s" : 'your pet\'s' %> first activity log.</p>
              </div>
            <% } %>
          </div>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <footer class="dash-footer">
      <div class="container footer-container">
        <div class="footer-brand">
          <h3>Woofy.</h3>
          <p>&copy; <%= new Date().getFullYear() %> Complete Pet Care & Health Tracking Platform.</p>
        </div>
        <div class="footer-links">
          <p>
            Designed & Developed by
            <a href="https://linkedin.com/in/shubham-rathod-tech" target="_blank" rel="noopener">
              Shubham Rathod
            </a>
          </p>
        </div>
      </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
      if (window.lucide) {
        lucide.createIcons();
      }
    </script>
  </body>
</html>
