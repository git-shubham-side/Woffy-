<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Track <%= typeof pet !== 'undefined' && pet ? pet.petName + "'s Activity" : 'Pet Activity' %> | Woofy</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/Track-Record-Form/tracking.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Ambient Background Lighting Mesh (Contained) -->
    <div class="ambient-glow-wrapper" aria-hidden="true">
      <div class="ambient-glow glow-1"></div>
      <div class="ambient-glow glow-2"></div>
    </div>

    <!-- Navigation -->
    <%- include('../partials/navbar', { activePage: 'pets' }) %>

    <main class="dashboard-main container">
      <!-- Flash Messages -->
      <%- include('../partials/flash-messages') %>

      <!-- Top Header Navigation & Meta -->
      <div class="track-page-header-bar">
        <a href="/api/select-pet-for-tracking" class="back-link">
          <i data-lucide="arrow-left" style="width: 15px; height: 15px;"></i>
          <span>Back to Pet Selection</span>
        </a>

        <% if (typeof pet !== 'undefined' && pet) { %>
        <a href="/api/show-records/<%= pet._id %>" class="btn btn-secondary btn-sm btn-header-records">
          <i data-lucide="clipboard-list" style="width: 15px; height: 15px;"></i>
          <span>View All <%= pet.petName %>'s Records</span>
        </a>
        <% } %>
      </div>

      <div class="page-header">
        <div class="page-header-title">
          <span class="page-badge-pill">Daily Wellness Logger</span>
          <h1>Track <span class="sketch-highlight"><%= typeof pet !== 'undefined' && pet ? pet.petName + "'s Activity" : 'Pet Activity' %></span></h1>
          <p>Log weight progress, medical checks, medicine dosages, vet visits, and grooming routines.</p>
        </div>
      </div>

      <!-- Main Layout Grid -->
      <div class="records-layout">
        <!-- LEFT SIDE: CLEAN TRACK RECORD FORM -->
        <section class="create-record-section">
          <form class="form-card" action="/api/track/create" method="POST" enctype="multipart/form-data">
            <div class="form-card-header">
              <div class="form-card-icon">
                <i data-lucide="plus-circle" style="width: 20px; height: 20px;"></i>
              </div>
              <div>
                <h2>Add New Care Log</h2>
                <p>Record medical, growth, or grooming details for <%= typeof pet !== 'undefined' && pet ? pet.petName : 'your pet' %>.</p>
              </div>
            </div>

            <% if (typeof pet !== 'undefined' && pet) { %>
              <input type="hidden" name="petId" value="<%= pet._id %>" />
            <% } %>

            <!-- Activity Type -->
            <div class="form-group">
              <label class="form-label">Activity / Care Category *</label>
              <div class="select-wrapper">
                <select name="activityType" class="form-select" required>
                  <option value="" disabled selected>Select category...</option>
                  <option value="weight">⚖️ Weight (Track Growth & Diet)</option>
                  <option value="medical">🩺 Medical (Surgeries / Health check)</option>
                  <option value="medicine">💊 Medicine (Dosages / Treatments)</option>
                  <option value="vet_history">📋 Vet History (Doctor Slips & Prescriptions)</option>
                  <option value="grooming">✂️ Grooming (Fur trim, Nails, Spa)</option>
                  <option value="bath">💧 Bath (Wash schedule & Skin care)</option>
                </select>
              </div>
            </div>

            <!-- Title / Measurement -->
            <div class="form-group">
              <label class="form-label">Measurement / Record Title *</label>
              <input
                type="text"
                name="title"
                class="form-control"
                placeholder="e.g. 24.5 kg, Deworming Pill, Rabies Booster"
                required
              />
            </div>

            <!-- Date -->
            <div class="form-group">
              <label class="form-label">Date *</label>
              <input
                type="date"
                name="date"
                class="form-control"
                required
                value="<%= new Date().toISOString().split('T')[0] %>"
              />
            </div>

            <!-- Attachment File -->
            <div class="form-group">
              <label class="form-label">Attach Doctor Slip / Prescription / Photo (Optional)</label>
              <input
                type="file"
                name="recordImage"
                class="form-control form-control-file"
                accept="image/*"
              />
              <span class="form-hint">Upload prescription receipt, medicine packaging, or photo (JPG, PNG).</span>
            </div>

            <!-- Additional Notes -->
            <div class="form-group">
              <label class="form-label">Care Notes & Instructions</label>
              <textarea
                name="notes"
                class="form-control form-textarea"
                placeholder="e.g. Given 1 tab after meals for 5 days, doctor advised rest, used anti-tick shampoo..."
                rows="3"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-block btn-save-log">
              <i data-lucide="check-circle-2" style="width: 18px; height: 18px;"></i>
              <span>Save Activity Log</span>
            </button>
          </form>
        </section>

        <!-- RIGHT SIDE: RECENT LOGS TIMELINE -->
        <section class="view-records-section">
          <div class="timeline-header-flex">
            <h2>Recent Activity Timeline</h2>
            <% if (typeof records !== 'undefined' && records.length > 0) { %>
              <span class="timeline-count-badge"><%= records.length %> <%= records.length === 1 ? 'Log' : 'Logs' %></span>
            <% } %>
          </div>

          <div class="records-list">
            <% if (typeof records !== 'undefined' && records.length > 0) { %>
              <% records.forEach(function(rec) { %>
                <div class="record-item">
                  <div class="record-icon icon-<%= rec.activityType %>">
                    <% if (rec.activityType === 'weight') { %>
                      <i data-lucide="scale"></i>
                    <% } else if (rec.activityType === 'medical') { %>
                      <i data-lucide="stethoscope"></i>
                    <% } else if (rec.activityType === 'medicine') { %>
                      <i data-lucide="pill"></i>
                    <% } else if (rec.activityType === 'vet_history') { %>
                      <i data-lucide="clipboard-list"></i>
                    <% } else if (rec.activityType === 'grooming') { %>
                      <i data-lucide="scissors"></i>
                    <% } else { %>
                      <i data-lucide="droplets"></i>
                    <% } %>
                  </div>
                  <div class="record-content">
                    <div class="record-header">
                      <span class="record-title"><%= rec.title %></span>
                      <span class="record-date">
                        <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                        <%= new Date(rec.date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                      </span>
                    </div>
                    <div class="record-badge-row">
                      <span class="badge badge-<%= rec.activityType %>"><%= rec.activityType.replace('_', ' ').toUpperCase() %></span>
                    </div>
                    <% if (rec.notes) { %>
                      <p class="record-desc">
                        <%= rec.notes %>
                      </p>
                    <% } %>
                    <% if (rec.image) { %>
                      <div class="record-attachment-wrap">
                        <a href="<%= rec.image %>" target="_blank" class="attachment-preview-link">
                          <img src="<%= rec.image %>" alt="Attached document" />
                          <span class="attachment-label">
                            <i data-lucide="external-link" style="width: 12px; height: 12px;"></i>
                            <span>View Attachment</span>
                          </span>
                        </a>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="empty-timeline-card">
                <div class="empty-timeline-icon">
                  <i data-lucide="activity" style="width: 36px; height: 36px;"></i>
                </div>
                <h4>No Activity Logs Yet</h4>
                <p>Fill out the form on the left to add <%= typeof pet !== 'undefined' && pet ? pet.petName + "'s" : 'your pet\'s' %> first activity log.</p>
              </div>
            <% } %>
          </div>
        </section>
      </div>
    </main>

    <!-- Global Universal Footer Partial -->
    <%- include('../partials/footer') %>

    <!-- Scripts -->
    <script src="/Dashboard/dashboard.js"></script>
    <script>
      if (window.lucide) {
        lucide.createIcons();
      }
    </script>
    <!-- Default Statcounter code for Woffy https://woffy.up.railway.app/ -->
    <script type="text/javascript">
    var sc_project=13353492; 
    var sc_invisible=1; 
    var sc_security="b129a7bd"; 
    </script>
    <script type="text/javascript"
    src="https://www.statcounter.com/counter/counter.js" async></script>
    <noscript><div class="statcounter"><a title="Web Analytics"
    href="https://statcounter.com/" target="_blank"><img class="statcounter"
    src="https://c.statcounter.com/13353492/0/b129a7bd/1/" alt="Web Analytics"
    referrerPolicy="no-referrer-when-downgrade"></a></div></noscript>
    <!-- End of Statcounter Code -->
  </body>
</html>