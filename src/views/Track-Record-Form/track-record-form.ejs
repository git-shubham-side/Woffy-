<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Track Activity | Woofy Premium Pet Care</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- External CSS -->
    <link rel="stylesheet" href="/Track-Record-Form/tracking.css" />

    <!-- Lucide Icons Script -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Top Navigation -->
    <header class="dashboard-nav">
      <div class="nav-container">
        <a href="/api/dashboard" class="logo">Woofy.</a>
        <div class="nav-actions">
          <a href="/api/pet-profiles" class="pet-profile-btn">
            <span class="avatar"><i data-lucide="paw-print"></i></span>
            <span>My Pets</span>
          </a>
          <a href="/logout" class="btn btn-secondary btn-sm">Log out</a>
        </div>
      </div>
    </header>

    <main class="dashboard-main container">
      <!-- Flash Messages -->
      <%- include('../partials/flash-messages') %>

      <!-- Breadcrumb & Header -->
      <a href="/api/select-pet-for-tracking" class="back-link"
        ><i data-lucide="arrow-left" style="width: 16px; height: 16px"></i> Back
        to Pet Selection</a
      >

      <div class="page-header">
        <div>
          <h1>Track <%= typeof pet !== 'undefined' && pet ? pet.petName + "'s Activity" : 'Pet Activity' %></h1>
          <p>Log health checks, medical treatments, baths, and grooming schedules.</p>
        </div>
      </div>

      <!-- Main Layout -->
      <div class="records-layout">
        <!-- LEFT SIDE: CREATE TRACK RECORD FORM -->
        <section class="create-record-section">
          <form class="form-card" action="/api/track/create" method="POST" enctype="multipart/form-data">
            <h2>Add New Log</h2>

            <% if (typeof pet !== 'undefined' && pet) { %>
              <input type="hidden" name="petId" value="<%= pet._id %>" />
            <% } %>

            <div class="form-group">
              <label class="form-label">Activity Type</label>
              <select name="activityType" class="form-control" required>
                <option value="" disabled selected>Select activity...</option>
                <option value="weight">Weight (Track growth)</option>
                <option value="medical">Medical (Past surgeries / Illness)</option>
                <option value="medicine">Medicine (Treatments / Pills)</option>
                <option value="vet_history">Vet History (Prescriptions)</option>
                <option value="grooming">Grooming (Spa & cuts)</option>
                <option value="bath">Bath (Wash schedule)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Title / Measurement</label>
              <input
                type="text"
                name="title"
                class="form-control"
                placeholder="e.g., 18.5 kg, Deworming Pill, Full Spa Grooming"
                required
              />
            </div>

            <div class="form-group">
              <label class="form-label">Date</label>
              <input type="date" name="date" class="form-control" required value="<%= new Date().toISOString().split('T')[0] %>" />
            </div>

            <div class="form-group">
              <label class="form-label">Attach Photo / Prescription / Medicine (Optional)</label>
              <input type="file" name="recordImage" class="form-control" accept="image/*" />
              <small style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-top: 0.25rem;">Upload prescription, medicine box, doctor slip, or photo.</small>
            </div>

            <div class="form-group">
              <label class="form-label">Additional Notes</label>
              <textarea
                name="notes"
                class="form-control"
                placeholder="Any specific details? (e.g., dosage, shampoo used, vet advice)"
              ></textarea>
            </div>

            <button
              type="submit"
              class="btn btn-primary btn-block"
              style="
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 8px;
              "
            >
              <i data-lucide="activity" style="width: 18px; height: 18px"></i>
              Save Tracking Log
            </button>
          </form>
        </section>

        <!-- RIGHT SIDE: VIEW RECENT LOGS -->
        <section class="view-records-section">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h2
              style="
                font-size: 1.25rem;
                margin-bottom: 0;
                color: var(--primary-color);
              "
            >
              Recent Logs
            </h2>
            <% if (typeof pet !== 'undefined' && pet) { %>
              <a href="/api/show-records/<%= pet._id %>" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 4px;">
                <i data-lucide="clipboard-list" style="width: 14px; height: 14px;"></i> View All Records
              </a>
            <% } %>
          </div>

          <div class="records-list">
            <% if (typeof records !== 'undefined' && records.length > 0) { %>
              <% records.forEach(function(rec) { %>
                <div class="record-item">
                  <div class="record-icon">
                    <% if (rec.activityType === 'weight') { %>
                      <i data-lucide="scale" style="color: #0369a1"></i>
                    <% } else if (rec.activityType === 'medical') { %>
                      <i data-lucide="stethoscope" style="color: #991b1b"></i>
                    <% } else if (rec.activityType === 'medicine') { %>
                      <i data-lucide="pill" style="color: #1e40af"></i>
                    <% } else if (rec.activityType === 'vet_history') { %>
                      <i data-lucide="clipboard-list" style="color: #065f46"></i>
                    <% } else if (rec.activityType === 'grooming') { %>
                      <i data-lucide="scissors" style="color: #7c3aed"></i>
                    <% } else { %>
                      <i data-lucide="droplets" style="color: #0284c7"></i>
                    <% } %>
                  </div>
                  <div class="record-content">
                    <div class="record-header">
                      <div class="record-title"><%= rec.title %></div>
                      <div class="record-date">
                        <%= new Date(rec.date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                      </div>
                    </div>
                    <span class="badge badge-<%= rec.activityType %>"><%= rec.activityType.replace('_', ' ').toUpperCase() %></span>
                    <% if (rec.notes) { %>
                      <p class="record-desc" style="margin-top: 0.75rem">
                        <%= rec.notes %>
                      </p>
                    <% } %>
                    <% if (rec.image) { %>
                      <div style="margin-top: 0.75rem;">
                        <a href="<%= rec.image %>" target="_blank" style="display: inline-block;">
                          <img src="<%= rec.image %>" alt="Attached photo" style="max-width: 140px; max-height: 95px; border-radius: 4px; border: 1px solid var(--border-color); object-fit: cover;" />
                        </a>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div style="text-align: center; padding: 3rem 1.5rem; background: var(--white); border: 1px solid var(--border-color); border-radius: var(--border-radius);">
                <div style="color: var(--text-muted); margin-bottom: 0.75rem;">
                  <i data-lucide="inbox" style="width: 36px; height: 36px;"></i>
                </div>
                <h4 style="margin-bottom: 0.25rem; color: var(--primary-color);">No logs yet</h4>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Fill out the form on the left to add your first activity log.</p>
              </div>
            <% } %>
          </div>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <footer class="dash-footer">
      <div class="container">
        <p>Woofy | Pet Management Application</p>
      </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
      lucide.createIcons();
    </script>
  </body>
</html>
