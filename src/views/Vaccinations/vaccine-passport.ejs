<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Official Pet Health & Vaccination Passport - <%= pet.petName %> | Woofy</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Cinzel:wght@700&display=swap"
      rel="stylesheet"
    />

    <style>
      @page {
        size: A4;
        margin: 1.5cm;
      }

      body {
        font-family: 'Inter', Arial, sans-serif;
        background: #f1f5f9;
        color: #0f172a;
        margin: 0;
        padding: 40px 20px;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .passport-sheet {
        max-width: 800px;
        margin: 0 auto;
        background: #ffffff;
        border: 2px solid #0f172a;
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        position: relative;
      }

      .watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-30deg);
        font-size: 5rem;
        font-weight: 900;
        color: rgba(15, 23, 42, 0.03);
        pointer-events: none;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .passport-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 3px double #0f172a;
        padding-bottom: 20px;
        margin-bottom: 25px;
      }

      .passport-title-box h1 {
        font-family: 'Cinzel', serif;
        margin: 0;
        font-size: 1.8rem;
        letter-spacing: 0.05em;
        color: #0f172a;
      }

      .passport-title-box p {
        margin: 4px 0 0 0;
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .passport-badge {
        text-align: right;
      }

      .badge-logo {
        font-size: 1.6rem;
        font-weight: 900;
        color: #0f172a;
      }
      .badge-logo span {
        color: #4f46e5;
      }

      .passport-id {
        font-family: monospace;
        font-size: 0.8rem;
        color: #64748b;
      }

      /* Profile Summary Grid */
      .pet-profile-grid {
        display: grid;
        grid-template-columns: 140px 1fr 1fr;
        gap: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 30px;
      }

      .pet-photo {
        width: 140px;
        height: 140px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #cbd5e1;
      }

      .info-field {
        margin-bottom: 8px;
      }

      .info-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .info-value {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
      }

      /* Section Heading */
      .section-heading {
        font-size: 1.1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid #0f172a;
        padding-bottom: 6px;
        margin: 25px 0 15px 0;
        display: flex;
        justify-content: space-between;
      }

      /* Table Styles */
      table.record-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }

      table.record-table th {
        background: #0f172a;
        color: #ffffff;
        text-align: left;
        padding: 10px 8px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      table.record-table td {
        padding: 10px 8px;
        border-bottom: 1px solid #e2e8f0;
        color: #1e293b;
      }

      table.record-table tr:nth-child(even) {
        background-color: #f8fafc;
      }

      .badge-status {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .badge-status.done {
        background: #dcfce7;
        color: #166534;
      }

      .badge-status.due {
        background: #fef3c7;
        color: #92400e;
      }

      .badge-status.overdue {
        background: #fee2e2;
        color: #991b1b;
      }

      .stamp-box {
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-top: 1px dashed #cbd5e1;
        padding-top: 20px;
      }

      .stamp-slot {
        width: 200px;
        text-align: center;
        border-top: 1px solid #0f172a;
        padding-top: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
      }

      /* Print Action Bar (Hidden during Print) */
      .action-bar {
        max-width: 800px;
        margin: 0 auto 20px auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .btn-print {
        background: #4f46e5;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
        font-size: 0.9rem;
      }

      .btn-back {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
      }

      @media print {
        body {
          background: #ffffff;
          padding: 0;
        }
        .passport-sheet {
          box-shadow: none;
          border: 1px solid #000;
          padding: 20px;
        }
        .action-bar {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Action Bar -->
    <div class="action-bar">
      <a href="/api/vaccinations/<%= pet._id %>" class="btn-back">&larr; Back to Vaccine Hub</a>
      <button onclick="window.print();" class="btn-print">🖨️ Print / Save as PDF</button>
    </div>

    <!-- Official Printable Sheet -->
    <div class="passport-sheet">
      <div class="watermark">WOOFY IMMUNIZED</div>

      <div class="passport-header">
        <div class="passport-title-box">
          <h1>Digital Pet Health Passport</h1>
          <p>Official Vaccination & Immunization Record</p>
        </div>
        <div class="passport-badge">
          <div class="badge-logo">Woofy<span>.</span></div>
          <div class="passport-id">ID: WF-<%= pet._id.toString().slice(-8).toUpperCase() %></div>
        </div>
      </div>

      <!-- Pet Info Grid -->
      <div class="pet-profile-grid">
        <img
          class="pet-photo"
          src="<%= pet.photo || pet.photoUrl || 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=300&q=80' %>"
          alt="<%= pet.petName %>"
        />
        <div>
          <div class="info-field">
            <div class="info-label">Pet Name</div>
            <div class="info-value"><%= pet.petName %></div>
          </div>
          <div class="info-field">
            <div class="info-label">Species & Breed</div>
            <div class="info-value"><%= pet.species %> &bull; <%= pet.breed %></div>
          </div>
          <div class="info-field">
            <div class="info-label">Gender & Weight</div>
            <div class="info-value"><%= pet.gender %> &bull; <%= pet.weight %> kg</div>
          </div>
        </div>

        <div>
          <div class="info-field">
            <div class="info-label">Owner / Guardian</div>
            <div class="info-value"><%= pet.ownerName || (user ? user.fullName : 'Registered Owner') %></div>
          </div>
          <div class="info-field">
            <div class="info-label">Owner Contact Email</div>
            <div class="info-value"><%= user ? user.email : 'N/A' %></div>
          </div>
          <div class="info-field">
            <div class="info-label">Date of Birth / Age</div>
            <div class="info-value">
              <% if (pet.dob) { %>
                <%= new Date(pet.dob).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %> (<%= pet.age %> yrs)
              <% } else { %>
                <%= pet.age %> Years
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Immunization History -->
      <div class="section-heading">
        <span>Immunization & Deworming Schedule</span>
        <span style="font-size: 0.8rem; font-weight: 500; text-transform: none; color: #64748b;">Generated via WSAVA Veterinary Protocol</span>
      </div>

      <table class="record-table">
        <thead>
          <tr>
            <th>Vaccine / Dose</th>
            <th>Category</th>
            <th>Due Date</th>
            <th>Administered</th>
            <th>Clinic / Vet</th>
            <th>Batch / Vial #</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (vaccinations && vaccinations.length > 0) { %>
            <% vaccinations.forEach(function(v) { %>
              <tr>
                <td><strong><%= v.vaccineName %></strong></td>
                <td><%= v.category %></td>
                <td><%= new Date(v.dueDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                <td>
                  <% if (v.administeredDate) { %>
                    <%= new Date(v.administeredDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  <% } else { %>
                    &mdash;
                  <% } %>
                </td>
                <td><%= v.clinicOrVetName || '—' %></td>
                <td><code><%= v.batchNumber || '—' %></code></td>
                <td>
                  <% if (v.status === 'Completed') { %>
                    <span class="badge-status done">Administered</span>
                  <% } else if (v.status === 'Overdue') { %>
                    <span class="badge-status overdue">Overdue</span>
                  <% } else { %>
                    <span class="badge-status due"><%= v.status %></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 20px; color: #64748b;">No vaccination records found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <!-- Verification Stamp & Signature -->
      <div class="stamp-box">
        <div>
          <div style="font-size: 0.75rem; color: #64748b; margin-bottom: 4px;">Verified by Woofy Platform</div>
          <div style="font-size: 0.85rem; font-weight: bold;">Date of Issue: <%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
        </div>
        <div class="stamp-slot">
          Veterinary Surgeon Signature & Stamp
        </div>
      </div>
    </div>
  </body>
</html>
