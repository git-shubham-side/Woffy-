<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hospital Listing Application | Woofy Partner</title>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/Hospitals/hospitals.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <!-- Top Navigation -->
    <%- include('../partials/navbar', { activePage: 'hospitals' }) %>

    <main class="hospitals-page">
      <div class="container">
        <!-- Flash Messages -->
        <%- include('../partials/flash-messages') %>

        <div class="form-wrapper-box">
          <div class="form-title-group">
            <span class="page-badge-pill">Partner Clinic Application</span>
            <h2>Register Your Hospital with Woofy</h2>
            <p>
              Fill in your veterinary clinic details below. Our company team will verify your application and publish your clinic listing to pet parents in your city.
            </p>
          </div>

          <form action="/services/hospitals/add" method="POST" enctype="multipart/form-data">
            <div class="form-grid-layout">
              <!-- 1. Hospital Name -->
              <div class="field-group full">
                <label for="name" class="field-label">Hospital / Clinic Official Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="field-input"
                  placeholder="e.g. Crown Vet 24/7 Multi-Speciality Pet Care"
                  required
                />
              </div>

              <!-- 2. Contact Person Name -->
              <div class="field-group">
                <label for="contactPerson" class="field-label">Contact Person Name *</label>
                <input
                  type="text"
                  id="contactPerson"
                  name="contactPerson"
                  class="field-input"
                  placeholder="e.g. Dr. Rajesh Sharma"
                  required
                />
              </div>

              <!-- 3. Contact Person Role -->
              <div class="field-group">
                <label for="contactRole" class="field-label">Your Designation / Role *</label>
                <input
                  type="text"
                  id="contactRole"
                  name="contactRole"
                  class="field-input"
                  placeholder="e.g. Chief Veterinarian / Clinic Director"
                  required
                />
              </div>

              <!-- 4. License Number -->
              <div class="field-group full">
                <label for="licenseNumber" class="field-label">Clinic License / Veterinary Reg. No (Optional)</label>
                <input
                  type="text"
                  id="licenseNumber"
                  name="licenseNumber"
                  class="field-input"
                  placeholder="e.g. VCI-2024-XXXX or State Council Reg."
                />
              </div>

              <!-- 5. City -->
              <div class="field-group">
                <label for="city" class="field-label">City *</label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  class="field-input"
                  placeholder="e.g. Mumbai, Pune, Delhi, Thane"
                  required
                />
              </div>

              <!-- 6. State -->
              <div class="field-group">
                <label for="state" class="field-label">State</label>
                <input
                  type="text"
                  id="state"
                  name="state"
                  class="field-input"
                  placeholder="e.g. Maharashtra"
                  value="Maharashtra"
                />
              </div>

              <!-- 7. Full Address -->
              <div class="field-group full">
                <label for="address" class="field-label">Full Street Address *</label>
                <input
                  type="text"
                  id="address"
                  name="address"
                  class="field-input"
                  placeholder="e.g. Plot No. 24, Near City Mall, Linking Road"
                  required
                />
              </div>

              <!-- 8. Pincode -->
              <div class="field-group">
                <label for="pincode" class="field-label">Pincode</label>
                <input
                  type="text"
                  id="pincode"
                  name="pincode"
                  class="field-input"
                  placeholder="e.g. 400050"
                />
              </div>

              <!-- 9. Phone Number -->
              <div class="field-group">
                <label for="phone" class="field-label">Reception / Clinic Phone *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="field-input"
                  placeholder="e.g. +91 98200 12345"
                  required
                />
              </div>

              <!-- 10. Emergency 24/7 Phone -->
              <div class="field-group">
                <label for="emergencyPhone" class="field-label">24/7 Emergency Helpline Phone</label>
                <input
                  type="tel"
                  id="emergencyPhone"
                  name="emergencyPhone"
                  class="field-input"
                  placeholder="e.g. +91 98200 99999"
                />
              </div>

              <!-- 11. Email Address -->
              <div class="field-group">
                <label for="email" class="field-label">Clinic Email Address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="field-input"
                  placeholder="e.g. contact@crownvet.com"
                />
              </div>

              <!-- 12. 24/7 Emergency Toggle -->
              <div class="field-group full" style="margin: 0.5rem 0;">
                <label class="checkbox-item" style="font-weight: 700; color: var(--primary-color);">
                  <input type="checkbox" name="is24x7" value="true" />
                  <span>This clinic operates as a 24/7 Emergency Care Center</span>
                </label>
              </div>

              <!-- 13. Services Checklist -->
              <div class="field-group full">
                <label class="field-label">Medical & Care Services Available (Check all that apply)</label>
                <div class="checkbox-grid">
                  <label class="checkbox-item"><input type="checkbox" name="services" value="24/7 Emergency" /> 24/7 Emergency</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="General OPD" checked /> General OPD</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Surgery" checked /> Surgery & OT</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Vaccination" checked /> Vaccination</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Dental Care" /> Dental Care</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Pet ICU" /> Pet ICU & Oxygen</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Digital X-Ray" /> Digital X-Ray</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Ultrasound / Sonography" /> Ultrasound / Sonography</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Pathology Lab" /> Pathology Lab</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Grooming & Spa" /> Grooming & Spa</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Boarding" /> Pet Boarding</label>
                  <label class="checkbox-item"><input type="checkbox" name="services" value="Pet Ambulance" /> Pet Ambulance</label>
                </div>
              </div>

              <!-- 14. Hospital Photo Upload -->
              <div class="field-group">
                <label for="photo" class="field-label">Upload Hospital Photo / Facade</label>
                <input
                  type="file"
                  id="photo"
                  name="photo"
                  class="field-input"
                  accept="image/*"
                  style="padding-top: 0.45rem;"
                />
              </div>

              <!-- 15. Photo URL Alternative -->
              <div class="field-group">
                <label for="photoUrl" class="field-label">Or Photo URL (optional)</label>
                <input
                  type="url"
                  id="photoUrl"
                  name="photoUrl"
                  class="field-input"
                  placeholder="https://images.unsplash.com/..."
                />
              </div>
            </div>

            <!-- Submit Action -->
            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
              <a href="/services/hospitals" class="btn btn-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Submit Hospital Application</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer>
      <div class="container footer-container">
        <div class="footer-brand">
          <h3>Woofy.</h3>
          <p>&copy; <%= new Date().getFullYear() %> Complete Pet Care & Health Tracking Platform.</p>
        </div>
        <div class="footer-links">
          <p>
            Designed & Developed by
            <a href="https://linkedin.com/in/shubham-rathod-tech" target="_blank" rel="noopener">
              Shubham Rathod
            </a>
          </p>
        </div>
      </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
      if (window.lucide) {
        lucide.createIcons();
      }
    </script>
    <!-- Default Statcounter code for Woffy https://woffy.up.railway.app/ -->
    <script type="text/javascript">
    var sc_project=13353492; 
    var sc_invisible=1; 
    var sc_security="b129a7bd"; 
    </script>
    <script type="text/javascript"
    src="https://www.statcounter.com/counter/counter.js" async></script>
    <noscript><div class="statcounter"><a title="Web Analytics"
    href="https://statcounter.com/" target="_blank"><img class="statcounter"
    src="https://c.statcounter.com/13353492/0/b129a7bd/1/" alt="Web Analytics"
    referrerPolicy="no-referrer-when-downgrade"></a></div></noscript>
    <!-- End of Statcounter Code -->
  </body>
</html>
