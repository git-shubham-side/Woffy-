<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit <%= pet.petName %>'s Profile | Woofy</title>
    <link rel="stylesheet" href="/Create-Profile/create-profile.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header id="navbar">
      <div class="container nav-container">
        <a href="/api/dashboard" class="logo">Woofy.</a>
        <nav class="nav-links">
          <a href="/api/dashboard">Home</a>
          <a href="/api/pet-profiles">My Pets</a>
        </nav>
      </div>
    </header>

    <section class="profile-page">
      <div class="container">
        <form class="form-card reveal" id="editPetForm" method="POST" action="/api/pet-profile/edit/<%= pet._id %>" enctype="multipart/form-data">
          <h2>Edit Pet Profile</h2>
          <p>
            Update <%= pet.petName %>'s details, health stats, and photos.
          </p>

          <!-- Flash Messages -->
          <%- include('../partials/flash-messages') %>

          <div class="form-row">
            <div class="form-group">
              <label for="petName">Pet Name *</label>
              <input
                type="text"
                id="petName"
                name="petName"
                required
                value="<%= pet.petName %>"
                placeholder="e.g. Jimmy"
              />
            </div>
            <div class="form-group">
              <label for="ownerName">Owner Name</label>
              <input
                type="text"
                id="ownerName"
                name="ownerName"
                value="<%= pet.ownerName || '' %>"
                placeholder="e.g. Shubham Rathod"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="species">Species</label>
              <select id="species" name="species" required>
                <option value="Dog" <%= pet.species === 'Dog' ? 'selected' : '' %>>Dog</option>
                <option value="Cat" <%= pet.species === 'Cat' ? 'selected' : '' %>>Cat</option>
                <option value="Other" <%= pet.species === 'Other' ? 'selected' : '' %>>Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="breed">Breed</label>
              <input type="text" id="breed" name="breed" value="<%= pet.breed || '' %>" placeholder="e.g. Labrador" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="age">Age (years)</label>
              <input
                type="number"
                id="age"
                name="age"
                min="0"
                step="0.1"
                value="<%= pet.age %>"
                placeholder="e.g. 2"
              />
            </div>
            <div class="form-group">
              <label for="weight">Weight (kg)</label>
              <input
                type="number"
                id="weight"
                name="weight"
                min="0"
                step="0.1"
                value="<%= pet.weight %>"
                placeholder="e.g. 18"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="gender">Gender</label>
              <select id="gender" name="gender">
                <option value="Male" <%= pet.gender === 'Male' ? 'selected' : '' %>>Male</option>
                <option value="Female" <%= pet.gender === 'Female' ? 'selected' : '' %>>Female</option>
              </select>
            </div>
            <div class="form-group">
              <label for="vaccinated">Vaccinated</label>
              <select id="vaccinated" name="vaccinated">
                <option value="Yes" <%= pet.vaccinated === 'Yes' ? 'selected' : '' %>>Yes</option>
                <option value="No" <%= pet.vaccinated === 'No' ? 'selected' : '' %>>No</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="petImage">Change Profile Photo</label>
              <% if (pet.photo || pet.photoUrl) { %>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.5rem;">
                  <img src="<%= pet.photo || pet.photoUrl %>" alt="<%= pet.petName %>" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid #cbd5e1;" />
                  <span style="font-size: 0.85rem; color: var(--text-muted);">Current Photo</span>
                </div>
              <% } %>
              <input type="file" id="petImage" name="petImage" accept="image/*" />
              <small style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-top: 0.25rem;">Upload new photo to replace current profile picture.</small>
            </div>
            <div class="form-group">
              <label for="photoUrl">Or Photo URL</label>
              <input type="url" id="photoUrl" name="photoUrl" value="<%= pet.photoUrl || '' %>" placeholder="https://..." />
            </div>
          </div>

          <div class="form-group">
            <label for="galleryImages">Add More Gallery Photos</label>
            <% if (pet.gallery && pet.gallery.length > 0) { %>
              <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 0.75rem;">
                <% pet.gallery.forEach(function(imgSrc) { %>
                  <img src="<%= imgSrc %>" alt="Gallery photo" style="width: 50px; height: 50px; border-radius: 4px; object-fit: cover; border: 1px solid #cbd5e1;" />
                <% }); %>
              </div>
            <% } %>
            <input type="file" id="galleryImages" name="galleryImages" accept="image/*" multiple />
            <small style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-top: 0.25rem;">Upload additional photos to add to <%= pet.petName %>'s gallery.</small>
          </div>

          <div class="form-group">
            <label for="notes">Additional Notes</label>
            <textarea
              id="notes"
              name="notes"
              placeholder="Allergies, favorite food, behaviour notes, etc."
            ><%= pet.notes || '' %></textarea>
          </div>

          <div class="form-actions" style="display: flex; gap: 1rem; align-items: center;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/api/pet-profile/<%= pet._id %>" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </section>

    <footer>
      <div class="container footer-container">
        <div class="footer-brand">
          <h2>Woofy.</h2>
          <p>Premium PetCare.</p>
        </div>
      </div>
    </footer>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="/Create-Profile/create-profile.js"></script>
  </body>
</html>
