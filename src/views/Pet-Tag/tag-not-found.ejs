<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pet Tag Not Found | Woofy</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/Pet-Tag/pet-tag.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="public-tag-body">
    <main class="public-tag-container" style="text-align: center; padding-top: 60px;">
      <div class="rescue-card">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: #fee2e2; color: #ef4444; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
          <i data-lucide="alert-octagon" style="width: 32px; height: 32px;"></i>
        </div>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 8px;">Collar Tag Not Found</h1>
        <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 24px;">
          The scanned collar ID <strong><%= typeof tagId !== 'undefined' ? tagId : '' %></strong> does not match an active pet profile or may have been removed.
        </p>

        <a href="/" class="btn-emergency-tap btn-emergency-call" style="background: #0f172a;">
          <i data-lucide="home" style="width: 18px; height: 18px;"></i>
          <span>Return to Woofy Home</span>
        </a>
      </div>
    </main>

    <script>
      lucide.createIcons();
    </script>
    <!-- Default Statcounter code for Woffy https://woffy.up.railway.app/ -->
    <script type="text/javascript">
    var sc_project=13353492; 
    var sc_invisible=1; 
    var sc_security="b129a7bd"; 
    </script>
    <script type="text/javascript"
    src="https://www.statcounter.com/counter/counter.js" async></script>
    <noscript><div class="statcounter"><a title="Web Analytics"
    href="https://statcounter.com/" target="_blank"><img class="statcounter"
    src="https://c.statcounter.com/13353492/0/b129a7bd/1/" alt="Web Analytics"
    referrerPolicy="no-referrer-when-downgrade"></a></div></noscript>
    <!-- End of Statcounter Code -->
  </body>
</html>
